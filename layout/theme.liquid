<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
    <meta name="theme-color" content="#344535">
    {% liquid
      assign body_font = settings.font_body
      assign heading_font = settings.font_heading
    %}
    {{ content_for_header }}
    {{ 'krozo.css' | asset_url | stylesheet_tag }}
    {{ 'krozo-enhancements.css' | asset_url | stylesheet_tag }}
    {% if request.page_type == 'index' %}
      <link rel="preload" href="{{ 'krozo-conversion.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
      <noscript>{{ 'krozo-conversion.css' | asset_url | stylesheet_tag }}</noscript>
    {% else %}
      {{ 'krozo-conversion.css' | asset_url | stylesheet_tag }}
    {% endif %}
    <style>
      {% if body_font != blank %}{{ body_font | font_face: font_display: 'swap' }}{% endif %}
      {% if heading_font != blank %}{{ heading_font | font_face: font_display: 'swap' }}{% endif %}

      :root{
        --cream:{{ settings.color_page_background | default: '#f9f7f1' }};
        --sand:{{ settings.color_surface_background | default: '#eee8da' }};
        --olive:{{ settings.color_brand | default: '#344535' }};
        --ink:{{ settings.color_text | default: '#263328' }};
        --muted:{{ settings.color_muted_text | default: '#687068' }};
        --border:{{ settings.color_border | default: '#e8e4dc' }};
        --button-bg:{{ settings.color_button_background | default: '#344535' }};
        --button-text:{{ settings.color_button_text | default: '#ffffff' }};
        --gold:{{ settings.color_rating | default: '#a68740' }};
        --font-body:{% if body_font != blank %}{{ body_font.family }}, {{ body_font.fallback_families }}{% else %}Inter, Arial, sans-serif{% endif %};
        --font-heading:{% if heading_font != blank %}{{ heading_font.family }}, {{ heading_font.fallback_families }}{% else %}'Playfair Display', Georgia, serif{% endif %};
        --body-scale:{{ settings.body_scale | default: 100 | divided_by: 100.0 }};
        --heading-scale:{{ settings.heading_scale | default: 100 | divided_by: 100.0 }};
        --container-width:{{ settings.container_width | default: 1320 }}px;
        --section-spacing-desktop:{{ settings.section_spacing_desktop | default: 90 }}px;
        --section-spacing-mobile:{{ settings.section_spacing_mobile | default: 62 }}px;
        --button-radius:{{ settings.button_radius | default: 4 }}px;
        --card-radius:{{ settings.card_radius | default: 6 }}px;
        --input-radius:{{ settings.input_radius | default: 0 }}px;
        --card-shadow-strength:{{ settings.card_shadow_strength | default: 8 | divided_by: 100.0 }};
        --button-case:{{ settings.button_text_transform | default: 'none' }};
        --button-letter-spacing:{{ settings.button_letter_spacing | default: 3 | divided_by: 100.0 }}em;
      }
      html{-webkit-text-size-adjust:100%;text-size-adjust:100%;overflow-x:hidden}
      body{max-width:100%;overflow-x:hidden}
      main{max-width:100%;overflow-x:clip}
      img,video,iframe{max-width:100%}

      .hero{position:relative;isolation:isolate;overflow:hidden;background-image:none!important}
      .hero__media{position:absolute;inset:0;z-index:0;overflow:hidden}
      .hero__media img{width:100%;height:100%;object-fit:cover;object-position:var(--hero-position,center center)}
      .hero:after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,rgba(239,233,220,.97) 0%,rgba(239,233,220,.83) 42%,rgba(239,233,220,.08) 73%)}
      .hero-content{position:relative;z-index:2}

      @supports(content-visibility:auto){
        #MainContent>.shopify-section:not(:first-child){content-visibility:auto;contain-intrinsic-size:auto 900px}
      }

      @media(min-width:751px){
        .product-page{grid-template-columns:minmax(0,1.04fr) minmax(390px,.96fr);gap:clamp(24px,2.4vw,40px);align-items:start}
        .product-media{width:100%;max-width:none;justify-self:stretch}
        .product-media__item:first-child{height:clamp(520px,46vw,640px);aspect-ratio:auto;overflow:hidden;border-radius:8px;background:#eeeae1}
        .product-media__item:first-child img,.product-media__item:first-child video{width:100%;height:100%;object-fit:cover;object-position:center;background:#eeeae1}
        .product-details{top:18px}
      }

      @media(max-width:750px){
        .hero:after{background:linear-gradient(90deg,rgba(239,233,220,.97) 0%,rgba(239,233,220,.84) 48%,rgba(239,233,220,.08) 82%)}
        .product-page,.product-media,.product-details,.product-details>*{min-width:0;max-width:100%}
        .product-media{display:flex!important;width:100%;gap:10px;margin:0!important;padding:0 0 10px!important;overflow-x:auto!important;overflow-y:hidden;scroll-snap-type:x mandatory}
        .product-media__item,.product-media__item:first-child{display:block;flex:0 0 100%;width:100%;min-width:100%!important;aspect-ratio:1/1;grid-column:auto;overflow:hidden;border-radius:8px;background:#fff;scroll-snap-align:start}
        .product-media img,.product-media video{width:100%!important;height:100%!important;object-fit:contain!important;background:#fff}
        .product-details h1{font-size:clamp(27px,8vw,34px)!important;line-height:1.08;overflow-wrap:anywhere}
        .product-summary{font-size:14px;line-height:1.65;overflow-wrap:anywhere}
        .product-benefit p,.product-description p,.purchase-accordions div{overflow-wrap:anywhere}
        .product-details select,.product-details input{width:100%;max-width:100%;font-size:16px}
        .product-review-preview,.review-summary,.rating-breakdown--wide{width:100%;max-width:100%;overflow:hidden}
        .product-review-preview__track{width:100%;max-width:100%}
        .product-review-preview__track article{flex:0 0 88%;min-width:0!important;width:88%;max-width:88%;overflow:hidden}
        .product-review-preview__track p{font-size:14px!important;line-height:1.5;overflow-wrap:anywhere}
        .sticky-atc{display:flex!important;visibility:visible!important;opacity:1!important;bottom:0;padding:10px 14px calc(10px + env(safe-area-inset-bottom));min-height:72px}
        .sticky-atc>span{min-width:0;overflow:hidden}
        .sticky-atc strong{font-size:12px;line-height:1.25}
        .sticky-atc .button{flex:0 0 auto;min-width:122px;min-height:48px;padding:12px 18px;font-size:14px}
        body{padding-bottom:calc(76px + env(safe-area-inset-bottom))}
      }
    </style>
    <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  </head>
  <body>
    {% sections 'header-group' %}
    <main id="MainContent">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}
    <script>
      window.KROZO_LOCALIZATION = {
        country: {{ localization.country.iso_code | json }},
        countryName: {{ localization.country.name | json }},
        currency: {{ localization.country.currency.iso_code | json }}
      };
    </script>
    <script src="{{ 'krozo.js' | asset_url }}" defer></script>
    {% if request.page_type == 'product' %}<script src="{{ 'krozo-product.js' | asset_url }}" defer></script>{% endif %}
    <script>
      (()=>{
        if(!window.matchMedia('(max-width:750px)').matches)return;
        const drawerSrc={{ 'krozo-currency-drawer-v2.js' | asset_url | json }};
        const countrySyncSrc={{ 'krozo-currency-country-sync.js' | asset_url | json }};
        let started=false;
        const loadCurrencyTools=()=>{
          if(started)return;
          started=true;
          const drawer=document.createElement('script');
          drawer.src=drawerSrc;
          drawer.defer=true;
          drawer.onload=()=>{
            const sync=document.createElement('script');
            sync.src=countrySyncSrc;
            sync.defer=true;
            document.head.appendChild(sync);
          };
          document.head.appendChild(drawer);
        };
        const interactionEvents=['pointerdown','touchstart','keydown'];
        const loadOnInteraction=()=>{
          interactionEvents.forEach(type=>window.removeEventListener(type,loadOnInteraction));
          loadCurrencyTools();
        };
        interactionEvents.forEach(type=>window.addEventListener(type,loadOnInteraction,{once:true,passive:true}));
        window.addEventListener('load',()=>{
          if('requestIdleCallback' in window)requestIdleCallback(loadCurrencyTools,{timeout:2800});
          else window.setTimeout(loadCurrencyTools,1600);
        },{once:true});
      })();
    </script>
  </body>
</html>
