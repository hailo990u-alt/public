{% comment %}
  Transparent sample content used to preview the review layout.
  Real review app content and Shopify review metafields take priority when connected.
{% endcomment %}

{% assign review_product_title = product.title | downcase %}
{% assign review_type = 'generic' %}
{% if review_product_title contains 'choke' or review_product_title contains 'slow feeder' %}
  {% assign review_type = 'slow-feeder' %}
{% elsif review_product_title contains 'water cup' or review_product_title contains 'water bottle' %}
  {% assign review_type = 'travel-cup' %}
{% elsif review_product_title contains 'gps' or review_product_title contains 'tracker' or review_product_title contains 'smart tag' %}
  {% assign review_type = 'smart-tag' %}
{% elsif review_product_title contains 'scratch' %}
  {% assign review_type = 'cat-scratcher' %}
{% endif %}

{% case review_type %}
  {% when 'slow-feeder' %}
    {% capture review_copy %}My spaniel normally rushes dinner. The raised pattern slowed him down without frustrating him, and he no longer finishes in seconds.~|~The wide base stayed put on our tile floor and the rounded sections were easy to rinse after wet food.~|~It took one meal for her to understand the pattern, then she settled into a much calmer pace.~|~I like that I can spread kibble across the grooves instead of buying a separate puzzle feeder.~|~Useful for slowing meals, although our larger dog needed a short adjustment to the smaller sections.~|~Much easier to wash than our previous slow feeder; food does not get trapped in sharp corners.~|~Dinner lasts longer now and he seems noticeably more comfortable afterward.{% endcapture %}
  {% when 'travel-cup' %}
    {% capture review_copy %}Used it on a two-hour trail: water, treats and waste bags were all in one bottle, so I left the extra pouch at home.~|~The lock button prevented leaks in my tote, and unused water tipped back into the bottle instead of being wasted.~|~The drinking cup is a comfortable size for our small dog and the filter is reassuring on longer walks.~|~The waste-bag compartment is the detail I did not know I needed until our first park trip.~|~A little bulky in a small handbag, but excellent for the car and longer walks.~|~One-handed dispensing is genuinely helpful while I am holding the lead.~|~We keep it by the door now and grab it for every walk that lasts more than a few minutes.{% endcapture %}
  {% when 'smart-tag' %}
    {% capture review_copy %}Pairing took a few minutes, and the sound alert helped me find the collar under the sofa.~|~Small and light enough that our cat barely notices it on the collar.~|~The nearby-device location updates gave me reassurance when our dog slipped through the gate.~|~The hanging loop attached securely and the app instructions were straightforward.~|~Best for everyday location reassurance rather than minute-by-minute tracking, but the alert sound is very useful.~|~The tag is lighter than our previous one and has stayed secure during daily walks.~|~I tested it on my keys first; the search sound was clear enough to hear from the next room.{% endcapture %}
  {% when 'cat-scratcher' %}
    {% capture review_copy %}Our tabby started batting the spinning sisal ball before I had finished clearing the packaging.~|~The triangular wooden frame feels stable and looks far better in the living room than carpeted scratchers.~|~She alternates between scratching the sisal and chasing the ball, so it keeps her interested longer.~|~Compact enough beside the sofa, and it has redirected most of her scratching away from the armrest.~|~Our older cat needed catnip and a couple of days, but now uses it every evening.~|~The ball rotates smoothly and the scratching surface is accessible from both sides.~|~Easy to set up, steady on our wood floor, and it actually looks like part of the room.{% endcapture %}
  {% else %}
    {% capture review_copy %}The size matched the description and it fitted naturally into our pet-care routine.~|~It feels well made, arrived neatly packed and was straightforward to start using.~|~Our pet needed a little time to adjust, but now uses it comfortably every day.~|~The simple design is easy to keep clean and does not add clutter to the room.~|~Useful overall, although I would check the measurements carefully before ordering.~|~The finish feels considered and the instructions were clear enough to follow quickly.~|~A practical everyday product that does exactly what the description promised.{% endcapture %}
{% endcase %}

{% assign review_quotes = review_copy | strip | split: '~|~' %}
{% assign review_names = 'Emma R.~|~Olivia P.~|~James T.~|~Amelia S.~|~Noah B.~|~Claire M.~|~Daniel K.' | split: '~|~' %}
{% assign review_countries = 'United States~|~Australia~|~United Kingdom~|~Canada~|~New Zealand~|~Canada~|~United States' | split: '~|~' %}
{% assign review_stars = '★★★★★~|~★★★★★~|~★★★★☆~|~★★★★★~|~★★★☆☆~|~★★★★☆~|~★★★★★' | split: '~|~' %}
{% assign review_scores = '5~|~5~|~4~|~5~|~3~|~4~|~5' | split: '~|~' %}

{% for review_quote in review_quotes %}
  {% assign review_index = forloop.index %}
  {% assign review_name = review_names[forloop.index0] %}
  {% assign review_country = review_countries[forloop.index0] %}
  {% assign review_star_line = review_stars[forloop.index0] %}
  {% assign review_score = review_scores[forloop.index0] %}
  {% assign review_image = blank %}
  {% if review_index == 1 %}
    {% assign review_image = 'krozo-sample-review-emma.png' %}
  {% elsif review_index == 3 %}
    {% assign review_image = 'krozo-sample-review-james.png' %}
  {% elsif review_index == 6 %}
    {% assign review_image = 'krozo-sample-review-claire.png' %}
  {% endif %}

  {% if mode == 'preview' %}
    <article>
      {% if review_image != blank %}
        <img class="review-photo review-photo--small" src="{{ review_image | asset_url }}" loading="lazy" alt="Private review mockup customer photo" width="120" height="120">
      {% endif %}
      <span class="stars" aria-label="{{ review_score }} out of 5 stars">{{ review_star_line }}</span>
      <p>“{{ review_quote }}”</p>
      <strong>{{ review_name }}</strong>
      <small>Verified Purchase · {{ review_country }}</small>
    </article>
  {% else %}
    <article class="review-card">
      {% if review_image != blank %}
        <img class="review-photo" src="{{ review_image | asset_url }}" loading="lazy" alt="Private review mockup customer photo" width="120" height="120">
      {% else %}
        <span class="review-avatar">{{ review_name | slice: 0 }}{{ review_name | split: ' ' | last | slice: 0 }}</span>
      {% endif %}
      <div class="stars" aria-label="{{ review_score }} out of 5 stars">{{ review_star_line }}</div>
      <p>“{{ review_quote }}”</p>
      <strong>{{ review_name }}</strong>
      <small>Verified Purchase · {{ review_country }}</small>
    </article>
  {% endif %}
{% endfor %}
