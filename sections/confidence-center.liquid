<section class="section confidence-center">
  <div class="confidence-center__intro">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <a class="text-link" href="/pages/contact">Talk to KROZO support <span aria-hidden="true">→</span></a>
  </div>

  <div class="confidence-center__cards">
    <article>
      <span class="confidence-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48"><path d="M7 14h23v19H7z"/><path d="M30 20h6l5 6v7H30z"/><circle cx="15" cy="36" r="3"/><circle cx="35" cy="36" r="3"/></svg>
      </span>
      <div><h3>Complimentary shipping</h3><p>Free shipping on every order, with delivery information shown at checkout.</p>{% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Shipping policy</a>{% endif %}</div>
    </article>
    <article>
      <span class="confidence-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48"><path d="M39 16A17 17 0 1 0 40 30"/><path d="M39 7v9h-9"/><path d="M17 24h14"/></svg>
      </span>
      <div><h3>30-day returns</h3><p>Changed your mind? Request a return within 30 days, subject to our returns policy.</p>{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Returns policy</a>{% endif %}</div>
    </article>
    <article>
      <span class="confidence-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48"><rect x="7" y="13" width="34" height="24" rx="3"/><path d="M7 21h34M13 30h9"/></svg>
      </span>
      <div><h3>Protected checkout</h3><p>Payments are encrypted and processed securely through Shopify’s checkout.</p><a href="{{ routes.cart_url }}">View your bag</a></div>
    </article>
    <article>
      <span class="confidence-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48"><path d="M11 27v-5a13 13 0 0 1 26 0v5"/><path d="M11 26H7v9h8v-9zM37 26h4v9h-8v-9z"/><path d="M33 39c-3 2-6 3-10 3"/></svg>
      </span>
      <div><h3>Human support</h3><p>Questions before or after ordering? Our support team is here to help.</p><a href="/pages/contact">Contact us</a></div>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Confidence center",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ORDER WITH CONFIDENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtful care, before and after checkout."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Clear policies, secure payment and helpful support—so choosing something special for your pet feels simple."
    }
  ],
  "presets": [
    {
      "name": "Confidence center"
    }
  ]
}
{% endschema %}
