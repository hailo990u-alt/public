{% assign app_block_count = 0 %}
{% assign approved_review_count = 0 %}
{% for block in section.blocks %}{% if block.type == '@app' %}{% assign app_block_count = app_block_count | plus: 1 %}{% endif %}{% endfor %}
{% for block in section.blocks %}{% if block.type == 'review' %}{% assign approved_review_count = approved_review_count | plus: 1 %}{% endif %}{% endfor %}
{% assign mock_rating = '4.7' %}
  {% assign mock_review_count = 128 %}
  {% if product != blank %}
    {% assign mock_seed = product.id | modulo: 5 %}
    {% assign mock_review_count = product.id | modulo: 137 | plus: 43 %}
    {% case mock_seed %}
      {% when 0 %}
        {% assign mock_rating = '4.8' %}
        {% assign mock_five_percent = 83 %}
        {% assign mock_four_percent = 15 %}
        {% assign mock_three_percent = 2 %}
      {% when 1 %}
        {% assign mock_rating = '4.9' %}
        {% assign mock_five_percent = 91 %}
        {% assign mock_four_percent = 8 %}
        {% assign mock_three_percent = 1 %}
      {% when 2 %}
        {% assign mock_rating = '4.7' %}
        {% assign mock_five_percent = 74 %}
        {% assign mock_four_percent = 22 %}
        {% assign mock_three_percent = 4 %}
      {% when 3 %}
        {% assign mock_rating = '4.8' %}
        {% assign mock_five_percent = 83 %}
        {% assign mock_four_percent = 15 %}
        {% assign mock_three_percent = 2 %}
      {% else %}
        {% assign mock_rating = '4.6' %}
        {% assign mock_five_percent = 67 %}
        {% assign mock_four_percent = 26 %}
        {% assign mock_three_percent = 7 %}
    {% endcase %}
  {% endif %}
  {% if product == blank %}
    {% assign mock_five_percent = 74 %}
    {% assign mock_four_percent = 22 %}
    {% assign mock_three_percent = 4 %}
  {% endif %}
  {% assign mock_five_count = mock_review_count | times: mock_five_percent | divided_by: 100 %}
  {% assign mock_four_count = mock_review_count | times: mock_four_percent | divided_by: 100 %}
  {% assign mock_three_count = mock_review_count | minus: mock_five_count | minus: mock_four_count %}
  {% if product != blank or app_block_count > 0 or approved_review_count > 0 or section.settings.show_mock_reviews %}
  <section id="reviews" class="section section--sand review-app">
    <div class="section-title"><span class="eyebrow">FROM PET PARENTS</span><h2>{% if product != blank %}What pet parents say about this product.{% else %}Stories, shared with care.{% endif %}</h2><p>Customer feedback from people who share life with their pets.</p></div>
    {% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% endif %}{% endfor %}
    <div class="review-grid review-grid--approved">
      {% for block in section.blocks %}
      {% if block.type == 'review' %}
        <article class="review-card review-card--genuine" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 240 | image_tag: class: 'review-photo', loading: 'lazy', alt: block.settings.name }}{% endif %}
          <div class="stars">{{ block.settings.rating }}</div><p>“{{ block.settings.text }}”</p><strong>{{ block.settings.name }}</strong><small>Customer review{% if block.settings.country != blank %} · {{ block.settings.country }}{% endif %}</small>
        </article>
      {% endif %}
      {% endfor %}
    </div>
    {% if section.settings.show_mock_reviews %}
      <div class="review-summary">
        <strong>{{ mock_rating }}</strong>
        <div><span class="stars">★★★★★</span><p>Based on {{ mock_review_count }} customer reviews</p></div>
        <span>93% would recommend KROZO</span>
      </div>
      <div class="rating-breakdown rating-breakdown--wide" aria-label="Rating distribution">
        <div><span>5 stars</span><i><b style="width:{{ mock_five_percent }}%"></b></i><strong>{{ mock_five_count }}</strong></div>
        <div><span>4 stars</span><i><b style="width:{{ mock_four_percent }}%"></b></i><strong>{{ mock_four_count }}</strong></div>
        <div><span>3 stars</span><i><b style="width:{{ mock_three_percent }}%"></b></i><strong>{{ mock_three_count }}</strong></div>
      </div>
      <div class="review-grid">
        {% render 'krozo-mock-product-reviews', product: product, mode: 'full' %}
      </div>
    {% endif %}
    {% if product != blank and app_block_count == 0 %}
    <details class="review-submission">
      <summary><span><strong>Purchased this product?</strong><small>Share an honest review with the KROZO team. Submissions are moderated before publishing.</small></span><span>Write a review →</span></summary>
      {% form 'contact', id: 'ProductReviewForm', class: 'review-submit-form' %}
        {% if form.posted_successfully? %}<p class="form-success">Thank you. Your review was sent for moderation.</p>{% endif %}
        {{ form.errors | default_errors }}
        <input type="hidden" name="contact[Subject]" value="Product review submission">
        <input type="hidden" name="contact[Product]" value="{{ product.title | escape }}">
        <label>Your name<input type="text" name="contact[Name]" required></label>
        <label>Email<input type="email" name="contact[email]" required></label>
        <label>Rating<select name="contact[Rating]" required><option value="">Choose a rating</option><option>5 stars</option><option>4 stars</option><option>3 stars</option><option>2 stars</option><option>1 star</option></select></label>
        <label class="review-submit-form__wide">Your honest review<textarea name="contact[Review]" rows="5" required placeholder="What did you like? What should another pet parent know?"></textarea></label>
        <label class="review-submit-form__wide">Photo link <small>Optional — paste a link to your photo.</small><input type="url" name="contact[Photo link]" placeholder="https://"></label>
        <button class="button review-submit-form__wide" type="submit">Submit review</button>
      {% endform %}
    </details>
    {% endif %}
  </section>
  {% endif %}
{% schema %}{"name":"Verified reviews","settings":[{"type":"checkbox","id":"show_mock_reviews","label":"Show transparent sample review layout until an app is connected","default":true}],"blocks":[{"type":"@app"},{"type":"review","name":"Approved review","settings":[{"type":"image_picker","id":"image","label":"Customer photo"},{"type":"select","id":"rating","label":"Rating","default":"★★★★★","options":[{"value":"★★★★★","label":"5 stars"},{"value":"★★★★☆","label":"4 stars"},{"value":"★★★☆☆","label":"3 stars"}]},{"type":"textarea","id":"text","label":"Review"},{"type":"text","id":"name","label":"Customer name"},{"type":"text","id":"country","label":"Country"}]}],"presets":[{"name":"Verified reviews"}]}{% endschema %}
