<div id="faq-help" class="faq-drawer-shell" data-faq-shell hidden>
  <button class="faq-drawer-overlay" type="button" aria-label="Close frequently asked questions" data-faq-close></button>
  <aside class="faq-drawer" role="dialog" aria-modal="true" aria-labelledby="FaqDrawerTitle">
    <div class="faq-drawer__head">
      <div>
        <span class="eyebrow">KROZO HELP</span>
        <h2 id="FaqDrawerTitle">Questions, answered.</h2>
      </div>
      <button class="icon-button faq-drawer__close" type="button" aria-label="Close frequently asked questions" data-faq-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <p class="faq-drawer__intro">Clear information about ordering, delivery, returns and choosing the right KROZO essential.</p>
    <div class="faq-drawer__list">
      {% for block in section.blocks %}
        <details {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question }}</span><span aria-hidden="true">+</span></summary>
          <div>{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
    <div class="faq-drawer__support">
      <strong>Still need help?</strong>
      <p>Tell us what you need and our support team will help you find the right next step.</p>
      <a class="button" href="/pages/contact">Contact KROZO</a>
    </div>
  </aside>
</div>
{% schema %}
{
  "name": "FAQ help drawer",
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {"type": "text", "id": "question", "label": "Question"},
        {"type": "richtext", "id": "answer", "label": "Answer"}
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ help drawer",
      "blocks": [
        {"type": "question", "settings": {"question": "Where does KROZO ship?", "answer": "<p>We currently serve customers in the United States, Canada, the United Kingdom, Australia and New Zealand. Available delivery options and estimates are shown at checkout.</p>"}},
        {"type": "question", "settings": {"question": "Is shipping complimentary?", "answer": "<p>Yes. Standard shipping is complimentary on every KROZO order. Any faster paid options, when available, are shown at checkout.</p>"}},
        {"type": "question", "settings": {"question": "How long will delivery take?", "answer": "<p>Delivery time depends on your destination and the product ordered. The most relevant estimate is shown during checkout and in your order confirmation.</p>"}},
        {"type": "question", "settings": {"question": "Can I return an item?", "answer": "<p>Changed your mind? You may request a return within 30 days, subject to our returns policy. If an item arrives damaged, defective or incorrect, contact us with your order number and clear photos. Depending on the issue and applicable law, we may offer a replacement, refund or a lower-impact resolution that does not require a return. This does not limit your statutory rights.</p>"}},
        {"type": "question", "settings": {"question": "How do I choose the right product or size?", "answer": "<p>Check the dimensions and guidance on the product page. If you are unsure, contact us before ordering and tell us about your pet.</p>"}},
        {"type": "question", "settings": {"question": "Are KROZO products safe for pets?", "answer": "<p>Each product page includes its available material and care information. Always supervise pets during play, follow the product guidance and replace damaged items.</p>"}},
        {"type": "question", "settings": {"question": "How can I track my order?", "answer": "<p>When tracking is available, you will receive it by email after dispatch. You can also contact us with your order number for help.</p>"}},
        {"type": "question", "settings": {"question": "Is checkout secure?", "answer": "<p>Available payment methods are displayed securely at checkout. Payments are encrypted and processed through Shopify-powered checkout.</p>"}},
        {"type": "question", "settings": {"question": "Can I change or cancel my order?", "answer": "<p>Contact us as quickly as possible. We will do our best to help, but changes cannot be guaranteed after an order enters processing.</p>"}},
        {"type": "question", "settings": {"question": "How do product reviews work?", "answer": "<p>Customers can submit honest feedback through the review area on each product page. Genuine critical feedback is not removed simply because it is negative.</p>"}}
      ]
    }
  ]
}
{% endschema %}
