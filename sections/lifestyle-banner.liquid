<section class="lifestyle-banner">
  <div class="lifestyle-banner__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '750,1100,1600,2200', sizes: '100vw' }}
    {% else %}
      <img
        src="{{ 'krozo-lifestyle-banner.webp' | asset_url }}"
        onerror="this.onerror=null;this.src='{{ 'krozo-lifestyle-banner.png' | asset_img_url: '1400x' }}';"
        loading="lazy"
        decoding="async"
        width="1400"
        height="788"
        alt="A quiet moment shared with a beloved pet"
      >
    {% endif %}
  </div>
  <div class="lifestyle-banner__overlay"></div>
  <div class="lifestyle-banner__navigation">
    <a class="slider-arrow slider-arrow--prev" href="#footer">‹</a>
  </div>
  <div class="lifestyle-banner__content">
    <p class="eyebrow">THE LIFE YOU SHARE</p>
    <h2>{{ section.settings.heading | default: 'More than products.<br>Better moments together.' }}</h2>
    <p>{{ section.settings.text | default: 'Everyday essentials chosen to make life with your pet feel calmer, easier, and more considered.' }}</p>
    <a href="{{ section.settings.link | default: '/collections/all' }}" class="text-link">{{ section.settings.link_label | default: 'Explore the collection →' }}</a>
  </div>
</section>
{% schema %}
{
  "name": "KROZO lifestyle banner",
  "settings": [
    {"type":"image_picker","id":"image","label":"Background image"},
    {"type":"text","id":"heading","label":"Heading"},
    {"type":"textarea","id":"text","label":"Text"},
    {"type":"url","id":"link","label":"Link"},
    {"type":"text","id":"link_label","label":"Link label"}
  ],
  "presets": [{"name": "KROZO lifestyle banner"}]
}
{% endschema %}
