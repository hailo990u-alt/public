{% assign banner_image = section.settings.image | default: 'krozo-lifestyle-banner.webp' %}
<section class="lifestyle-banner">
  <div class="lifestyle-banner__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'lazy', decoding: 'async', widths: '480,750,1100,1600,2200', sizes: '100vw', alt: 'A quiet moment shared with a beloved pet' }}
    {% else %}
      <img src="{{ banner_image | asset_img_url: '1400x' }}" srcset="{{ banner_image | asset_img_url: '480x' }} 480w, {{ banner_image | asset_img_url: '750x' }} 750w, {{ banner_image | asset_img_url: '1100x' }} 1100w, {{ banner_image | asset_img_url: '1400x' }} 1400w, {{ banner_image | asset_img_url: '1800x' }} 1800w" sizes="100vw" loading="lazy" decoding="async" alt="A quiet moment shared with a beloved pet" width="1672" height="941">
    {% endif %}
  </div>
  <div class="lifestyle-banner__content">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {% if section.settings.link_label != blank %}
      <a class="text-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label }} →</a>
    {% endif %}
  </div>
</section>

{% schema %}
{"name":"Lifestyle banner","settings":[{"type":"image_picker","id":"image","label":"Lifestyle image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE LIFE YOU SHARE"},{"type":"text","id":"heading","label":"Heading","default":"More than products. Better moments together."},{"type":"textarea","id":"text","label":"Text","default":"Everyday essentials chosen to make life with your pet feel calmer, easier, and more considered."},{"type":"text","id":"link_label","label":"Link label","default":"Explore the collection"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Lifestyle banner"}]}
{% endschema %}
