<section class="product-page section">
  {% capture marketing_title %}{% render 'krozo-product-title', product: product %}{% endcapture %}
  {% capture marketing_summary %}{% render 'krozo-product-summary', product: product %}{% endcapture %}
  {% assign product_title_downcase = product.title | downcase %}
  {% assign real_rating = product.metafields.reviews.rating.value %}
  {% assign real_review_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count %}
  {% assign real_rating_value = real_rating.rating | default: real_rating.value | default: real_rating %}
  {% assign real_review_count_number = real_review_count | plus: 0 %}
  {% assign judgeme_data = product.metafields.judgeme.review_widget_data.value %}
  {% assign judgeme_review_count = judgeme_data.number_of_reviews | plus: 0 %}
  {% if judgeme_review_count > 0 %}
    {% assign real_rating_value = judgeme_data.average_rating %}
    {% assign real_review_count = judgeme_review_count %}
    {% assign real_review_count_number = judgeme_review_count %}
  {% endif %}
  {% assign real_purchase_count = product.metafields.custom.purchases_count.value | default: product.metafields.custom.purchases_count %}
  {% assign show_design_preview = false %}
  {% if section.settings.show_mock_social_proof %}{% assign show_design_preview = true %}{% endif %}
  {% assign mock_seed = product.id | modulo: 5 %}
  {% assign mock_review_count = product.id | modulo: 137 | plus: 43 %}
  {% assign mock_purchase_count = product.id | modulo: 389 | plus: 126 %}
  {% case mock_seed %}
    {% when 0 %}
      {% assign mock_rating = '4.8' %}
    {% when 1 %}
      {% assign mock_rating = '4.9' %}
    {% when 2 %}
      {% assign mock_rating = '4.7' %}
    {% when 3 %}
      {% assign mock_rating = '4.8' %}
    {% else %}
      {% assign mock_rating = '4.6' %}
  {% endcase %}
  {% assign initial_variant = product.selected_or_first_available_variant %}
  {% assign grooming_bundle_variant = blank %}
  {% for variant in product.variants %}
    {% if variant.sku == 'CJGY191930714NM' or variant.title contains 'Complete Grooming Trio' %}
      {% assign grooming_bundle_variant = variant %}
      {% break %}
    {% endif %}
  {% endfor %}
  <div class="product-media" data-product-gallery>
    {% for media in product.media %}
      {% if media.media_type == 'image' %}
        <a href="{{ media | image_url: width: 2200 }}" class="product-media__item{% if initial_variant.featured_media.id == media.id %} is-variant-active{% endif %}" data-media-id="{{ media.id }}" aria-label="Zoom product image">
          {% if forloop.first %}
            {{ media | image_url: width: 1300 | image_tag: loading: 'eager', fetchpriority: 'high', decoding: 'async', alt: product.title, widths: '420,600,800,1000,1300', sizes: '(max-width: 750px) 100vw, 52vw' }}
          {% else %}
            {{ media | image_url: width: 1300 | image_tag: loading: 'lazy', fetchpriority: 'low', decoding: 'async', alt: product.title, widths: '420,600,800,1000,1300', sizes: '(max-width: 750px) 100vw, 52vw' }}
          {% endif %}
        </a>
      {% elsif media.media_type == 'video' %}
        <div class="product-media__item{% if initial_variant.featured_media.id == media.id %} is-variant-active{% endif %}" data-media-id="{{ media.id }}">{{ media | video_tag: controls: true, muted: true, loop: true }}</div>
      {% endif %}
    {% endfor %}
  </div>
  <div class="product-details">
    {% if section.settings.show_ratings_summary and show_design_preview %}
      <a class="product-page__rating" href="#reviews"><span aria-hidden="true">★★★★★</span><strong>{{ mock_rating }}</strong><span>{{ mock_review_count }} reviews</span></a>
    {% elsif section.settings.show_ratings_summary and real_rating_value != blank and real_review_count_number > 0 %}
      <a class="product-page__rating" href="#reviews"><span aria-hidden="true">★★★★★</span><strong>{{ real_rating_value | round: 1 }}</strong><span>{{ real_review_count }} {% if real_review_count_number == 1 %}review{% else %}reviews{% endif %}</span></a>
    {% elsif section.settings.show_ratings_summary %}
      <a class="product-page__rating product-page__rating--empty" href="#reviews"><span aria-hidden="true">☆☆☆☆☆</span><span>Write the first review</span></a>
    {% endif %}
    {% if section.settings.show_purchase_count and show_design_preview %}
      <p class="purchase-count">{{ mock_purchase_count }}+ purchased</p>
    {% elsif section.settings.show_purchase_count and real_purchase_count != blank %}
      <p class="purchase-count">{{ real_purchase_count }} purchased</p>
    {% endif %}
    <h1>{{ marketing_title | strip }}</h1>
    <p class="price"><span class="money" data-unit-price data-price-cents="{{ initial_variant.price }}">{{ initial_variant.price | money }}</span> <small class="price__unit">per item</small></p>
    <p class="product-summary">{{ marketing_summary | strip }}</p>
    {% if section.settings.show_benefits %}<div class="product-benefit-list" aria-label="Product benefits">
      {% if product.id == 8307370459225 %}
        <div class="product-benefit"><span>✓</span><p>Circulating water encourages pets to drink more often</p></div>
        <div class="product-benefit"><span>✓</span><p>Quiet flow keeps hydration calm and inviting</p></div>
        <div class="product-benefit"><span>✓</span><p>Replaceable filtration helps keep every sip fresher</p></div>
      {% elsif product_title_downcase contains 'choke' or product_title_downcase contains 'slow feeder' %}
        <div class="product-benefit"><span>✓</span><p>Encourages a calmer, slower eating pace</p></div>
        <div class="product-benefit"><span>✓</span><p>Rounded grooves rinse clean with less effort</p></div>
        <div class="product-benefit"><span>✓</span><p>Wide shape helps the bowl stay steady during meals</p></div>
      {% elsif product_title_downcase contains 'water cup' or product_title_downcase contains 'water bottle' %}
        <div class="product-benefit"><span>✓</span><p>Carries water, treats and waste bags together</p></div>
        <div class="product-benefit"><span>✓</span><p>Lockable one-hand flow helps prevent leaks</p></div>
        <div class="product-benefit"><span>✓</span><p>Designed for walks, car journeys and day trips</p></div>
      {% elsif product_title_downcase contains 'gps' or product_title_downcase contains 'tracker' or product_title_downcase contains 'smart tag' %}
        <div class="product-benefit"><span>✓</span><p>Lightweight design for collars, keys and bags</p></div>
        <div class="product-benefit"><span>✓</span><p>Audible search alert helps with nearby finding</p></div>
        <div class="product-benefit"><span>✓</span><p>Compatible app connection for everyday reassurance</p></div>
      {% elsif product_title_downcase contains 'scratch' %}
        <div class="product-benefit"><span>✓</span><p>Satisfies natural scratching and batting instincts</p></div>
        <div class="product-benefit"><span>✓</span><p>Rotating sisal ball encourages active daily play</p></div>
        <div class="product-benefit"><span>✓</span><p>Stable wooden frame helps redirect furniture scratching</p></div>
      {% elsif product_title_downcase contains 'fountain' or product_title_downcase contains 'water dispenser' %}
        <div class="product-benefit"><span>✓</span><p>Circulating water encourages pets to drink more often</p></div>
        <div class="product-benefit"><span>✓</span><p>Quiet flow keeps hydration calm and inviting</p></div>
        <div class="product-benefit"><span>✓</span><p>Filtration helps keep every sip fresher</p></div>
      {% elsif product_title_downcase contains 'litter scoop' %}
        <div class="product-benefit"><span>✓</span><p>Built-in waste bin keeps disposal bags within reach</p></div>
        <div class="product-benefit"><span>✓</span><p>Scoop and contain litter mess in one simple motion</p></div>
        <div class="product-benefit"><span>✓</span><p>Compact design keeps clean-up tools organised</p></div>
      {% elsif product_title_downcase contains 'grooming brush' or product_title_downcase contains 'one-click' %}
        <div class="product-benefit"><span>✓</span><p>Rounded bristles remove loose fur without harsh pulling</p></div>
        <div class="product-benefit"><span>✓</span><p>One-click release clears collected hair in seconds</p></div>
        <div class="product-benefit"><span>✓</span><p>Comfortable grip makes regular grooming easier</p></div>
      {% elsif product_title_downcase contains 'roller brush' or product_title_downcase contains 'hair remover brush' %}
        <div class="product-benefit"><span>✓</span><p>Lifts embedded pet hair from sofas and clothing</p></div>
        <div class="product-benefit"><span>✓</span><p>Reusable roller reduces disposable cleaning sheets</p></div>
        <div class="product-benefit"><span>✓</span><p>Compact design is ready for quick daily touch-ups</p></div>
      {% elsif product_title_downcase contains 'treatquest' or product_title_downcase contains 'treat puzzle' or product_title_downcase contains 'feeder toy' %}
        <div class="product-benefit"><span>✓</span><p>Turns treats into a rewarding problem-solving game</p></div>
        <div class="product-benefit"><span>✓</span><p>Random dispensing keeps curious pets engaged longer</p></div>
        <div class="product-benefit"><span>✓</span><p>Encourages slower snacking and independent play</p></div>
      {% elsif product_title_downcase contains 'cat toy ball' %}
        <div class="product-benefit"><span>✓</span><p>Self-moving action sparks natural chasing instincts</p></div>
        <div class="product-benefit"><span>✓</span><p>Unpredictable rolling keeps indoor play interesting</p></div>
        <div class="product-benefit"><span>✓</span><p>Helps cats stay active while playing independently</p></div>
      {% elsif product_title_downcase contains 'pet stairs' %}
        <div class="product-benefit"><span>✓</span><p>Gentle steps make sofas and beds easier to reach</p></div>
        <div class="product-benefit"><span>✓</span><p>Supportive foam cushions paws and joints</p></div>
        <div class="product-benefit"><span>✓</span><p>Removable cover simplifies everyday cleaning</p></div>
      {% elsif product_title_downcase contains 'pooper scooper' %}
        <div class="product-benefit"><span>✓</span><p>Claw pickup keeps hands farther from outdoor waste</p></div>
        <div class="product-benefit"><span>✓</span><p>Built-in bag dispenser keeps supplies ready</p></div>
        <div class="product-benefit"><span>✓</span><p>Portable shape clips easily onto walking gear</p></div>
      {% elsif product_title_downcase contains 'cat cave bed' %}
        <div class="product-benefit"><span>✓</span><p>Enclosed cave creates a warm private place to rest</p></div>
        <div class="product-benefit"><span>✓</span><p>Soft cushioning supports comfortable naps</p></div>
        <div class="product-benefit"><span>✓</span><p>Hanging ball adds gentle play beside the bed</p></div>
      {% elsif product_title_downcase contains 'built-in bowl' %}
        <div class="product-benefit"><span>✓</span><p>Built-in silicone bowl makes outdoor drinking easy</p></div>
        <div class="product-benefit"><span>✓</span><p>Leak-resistant seal protects bags during travel</p></div>
        <div class="product-benefit"><span>✓</span><p>Lightweight shape fits easily with walk essentials</p></div>
      {% else %}
        {% for block in section.blocks %}
          <div class="product-benefit" {{ block.shopify_attributes }}><span>✓</span><p>{{ block.settings.text }}</p></div>
        {% endfor %}
      {% endif %}
    </div>{% endif %}
    <p class="availability" data-product-availability><span></span>{% if initial_variant.available %}{% if initial_variant.inventory_management != blank and initial_variant.inventory_policy == 'deny' and initial_variant.inventory_quantity > 0 and initial_variant.inventory_quantity <= 8 %}Only {{ initial_variant.inventory_quantity }} left — ready to ship{% else %}In stock and ready to order{% endif %}{% else %}Currently unavailable{% endif %}</p>
    <div class="krozo-order-offer" role="note">
      <span class="krozo-order-offer__label">WELCOME OFFER</span>
      <p><strong>10% off your first order</strong> · Code: <code>WELCOME10</code></p>
    </div>
    <p class="delivery-estimate"><strong>Estimated delivery:</strong> 4–9 business days, depending on your destination and local carrier conditions.</p>
    {% assign product_form_currency = shop.currency %}
    {% form 'product', product, data-product-form: '', data-currency: product_form_currency %}
      {% unless product.has_only_default_variant %}
        <label>Choose an option
          <select name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-variant-title="{{ variant.title | escape }}" data-price="{{ variant.price }}" data-available="{{ variant.available }}" data-inventory-tracked="{% if variant.inventory_management != blank and variant.inventory_policy == 'deny' %}true{% else %}false{% endif %}" data-inventory-quantity="{{ variant.inventory_quantity }}" data-media-id="{{ variant.featured_media.id }}" {% if variant.id == initial_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select>
        </label>
        {% if grooming_bundle_variant != blank %}
          {% assign grooming_bundle_saving = grooming_bundle_variant.compare_at_price | minus: grooming_bundle_variant.price %}
          <aside class="grooming-bundle-offer{% if initial_variant.id == grooming_bundle_variant.id %} is-selected{% endif %}" data-bundle-offer data-bundle-variant-id="{{ grooming_bundle_variant.id }}" aria-label="Recommended grooming bundle">
            <div class="grooming-bundle-offer__media">{% if grooming_bundle_variant.featured_media.preview_image %}{{ grooming_bundle_variant.featured_media.preview_image | image_url: width: 420 | image_tag: loading: 'lazy', decoding: 'async', widths: '180,280,420', alt: 'KROZO Complete Grooming Trio' }}{% endif %}</div>
            <div class="grooming-bundle-offer__content">
              <div class="grooming-bundle-offer__topline"><span>RECOMMENDED BUNDLE</span><strong>BEST VALUE</strong></div>
              <h3>Complete Grooming Trio</h3>
              <p>SteamGroom mist brush + hair-removal brush + grooming glove.</p>
              <div class="grooming-bundle-offer__price"><strong class="money">{{ grooming_bundle_variant.price | money }}</strong>{% if grooming_bundle_variant.compare_at_price > grooming_bundle_variant.price %}<s class="money">{{ grooming_bundle_variant.compare_at_price | money }}</s><span>Save {{ grooming_bundle_saving | money }}</span>{% endif %}</div>
              <button class="grooming-bundle-offer__button" type="button" data-choose-bundle><span data-bundle-button-label>{% if initial_variant.id == grooming_bundle_variant.id %}Bundle selected ✓{% else %}Choose this bundle{% endif %}</span></button>
            </div>
          </aside>
        {% endif %}
      {% else %}
        <input type="hidden" name="id" value="{{ initial_variant.id }}" data-price="{{ initial_variant.price }}" data-available="{{ initial_variant.available }}" data-inventory-tracked="{% if initial_variant.inventory_management != blank and initial_variant.inventory_policy == 'deny' %}true{% else %}false{% endif %}" data-inventory-quantity="{{ initial_variant.inventory_quantity }}" data-media-id="{{ initial_variant.featured_media.id }}">
      {% endunless %}
      <label>Quantity <input type="number" name="quantity" min="1" value="1" inputmode="numeric" data-product-quantity></label>
      <div class="product-total"><span>Order total</span><strong class="price"><span class="money" data-product-total>{{ initial_variant.price | money }}</span></strong></div>
      <button class="button product-atc" type="submit" {% unless initial_variant.available %}disabled{% endunless %}>{% if initial_variant.available %}Add to cart{% else %}Sold out{% endif %}</button>
      {% if section.settings.show_dynamic_checkout %}{{ form | payment_button }}{% endif %}
    {% endform %}
    {% if grooming_bundle_variant == blank %}
      <aside class="grooming-bundle-offer grooming-bundle-offer--compact" data-global-bundle-offer aria-label="Recommended grooming bundle">
        <div class="grooming-bundle-offer__media">
          <img src="https://cdn.shopify.com/s/files/1/0743/6143/8297/files/krozo-complete-grooming-trio-best-value.png?v=1786640870" loading="lazy" decoding="async" width="420" height="420" alt="KROZO Complete Grooming Trio">
        </div>
        <div class="grooming-bundle-offer__content">
          <div class="grooming-bundle-offer__topline"><span>YOU MAY ALSO LIKE</span><strong>BEST VALUE</strong></div>
          <h3>Complete Grooming Trio</h3>
          <p>SteamGroom mist brush + hair-removal brush + grooming glove.</p>
          <div class="grooming-bundle-offer__price"><strong class="money">{{ 4999 | money }}</strong><s class="money">{{ 6899 | money }}</s><span>Save {{ 1900 | money }}</span></div>
          <form method="post" action="{{ routes.cart_add_url }}" class="grooming-bundle-offer__form">
            <input type="hidden" name="id" value="44384904118361">
            <input type="hidden" name="quantity" value="1">
            <button class="grooming-bundle-offer__button" type="submit">Add bundle to cart</button>
          </form>
        </div>
      </aside>
    {% endif %}
    <script type="application/json" data-krozo-product-variants>[
      {% for variant in product.variants %}
        {"id":{{ variant.id | json }},"mediaId":{{ variant.featured_media.id | json }}}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]</script>
    <script>
      (() => {
        const section = document.currentScript.closest('.product-page');
        const gallery = section && section.querySelector('[data-product-gallery]');
        const variantData = section && section.querySelector('[data-krozo-product-variants]');
        if (!gallery || !variantData) return;
        let variants = [];
        try { variants = JSON.parse(variantData.textContent); } catch (error) { return; }
        const showVariantImage = variantId => {
          const variant = variants.find(item => String(item.id) === String(variantId));
          if (!variant || !variant.mediaId) return;
          const target = gallery.querySelector('[data-media-id="' + variant.mediaId + '"]');
          if (!target) return;
          gallery.querySelectorAll('[data-media-id]').forEach(item => item.classList.remove('is-variant-active'));
          target.classList.add('is-variant-active');
          gallery.prepend(target);
          gallery.scrollTo({ left: 0, behavior: 'smooth' });
        };
        section.addEventListener('change', event => {
          if (event.target.matches('select[name="id"]')) showVariantImage(event.target.value);
        });
        section.addEventListener('click', event => {
          const chooseButton = event.target.closest('[data-choose-bundle]');
          if (!chooseButton) return;
          event.preventDefault();
          const offer = chooseButton.closest('[data-bundle-offer]');
          const form = chooseButton.closest('form');
          const select = form && form.querySelector('select[name="id"]');
          if (!offer || !form || !select || !offer.dataset.bundleVariantId) return;
          select.value = offer.dataset.bundleVariantId;
          select.dispatchEvent(new Event('change', { bubbles: true }));
          offer.classList.add('is-selected');
          const label = chooseButton.querySelector('[data-bundle-button-label]');
          if (label) label.textContent = 'Adding bundle…';
          chooseButton.disabled = true;
          window.setTimeout(() => {
            if (form.requestSubmit) form.requestSubmit();
            else form.submit();
          }, 80);
        });
        const initialSelect = section.querySelector('select[name="id"]');
        if (initialSelect) showVariantImage(initialSelect.value);
      })();
    </script>

    {% if section.settings.show_trust_badges %}<div class="essential-trust-badges" aria-label="Essential trust badges">
      <article><svg viewBox="0 0 24 24"><path d="M12 3 20 6v5c0 5-3.2 8.3-8 10-4.8-1.7-8-5-8-10V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg><span><strong>Secure checkout</strong><small>Encrypted Shopify payment</small></span></article>
      <article><svg viewBox="0 0 24 24"><path d="M3 7h12v10H3zM15 10h3l3 3v4h-6z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg><span><strong>Free shipping</strong><small>On every KROZO order</small></span></article>
      <article><svg viewBox="0 0 24 24"><path d="M4 7v5h5"/><path d="M5.5 12A7 7 0 1 0 7 6.5L4 9"/></svg><span><strong>30-day returns</strong><small>Simple return request</small></span></article>
      <article><svg viewBox="0 0 24 24"><path d="M5 18v-6a7 7 0 0 1 14 0v6"/><path d="M5 14H3v5h4v-5zM19 14h2v5h-4v-5z"/></svg><span><strong>Helpful support</strong><small>Before and after ordering</small></span></article>
    </div>{% endif %}
    {% if shop.enabled_payment_types.size > 0 %}<div class="payment-trust"><strong>Secure payment options</strong><div>{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div><small>Payments are encrypted and processed securely by Shopify.</small></div>{% endif %}
    {% for block in section.blocks %}{% if block.type == '@app' %}<div class="product-app-block" {{ block.shopify_attributes }}>{% render block %}</div>{% endif %}{% endfor %}
    <div class="purchase-accordions">
      <details>
        <summary><span>Complimentary shipping</span><span aria-hidden="true">+</span></summary>
        <div>Shipping is free on every KROZO order. Estimated delivery is 4–9 business days, depending on your destination and local carrier conditions.{% if shop.shipping_policy != blank %} <a href="{{ shop.shipping_policy.url }}">Read our shipping policy</a>.{% else %} <a href="/pages/shipping-handling">Read our shipping policy</a>.{% endif %}</div>
      </details>
      <details>
        <summary><span>Returns & damaged items</span><span aria-hidden="true">+</span></summary>
        <div>Changed your mind? You may request a return within 30 days, subject to our returns policy. If an item arrives damaged, defective or incorrect, contact us with your order number and clear photos. Depending on the issue and applicable law, we may offer a replacement, refund or another appropriate resolution. This does not limit your statutory rights. <a href="/pages/returns-refunds">Read our returns policy</a>.</div>
      </details>
      <details>
        <summary><span>Secure payment & support</span><span aria-hidden="true">+</span></summary>
        <div>Checkout is encrypted and payments are processed securely by Shopify. Need help? <a href="/pages/contact">Contact KROZO support</a>.</div>
      </details>
    </div>
    <div class="product-description"><span class="eyebrow">{{ section.settings.description_eyebrow }}</span><h2>{{ section.settings.description_heading }}</h2>{% if product.description != blank %}<div class="rte">{{ product.description }}</div>{% else %}<p>{{ marketing_summary | strip }}</p>{% endif %}</div>
  </div>
</section>
{% if section.settings.show_sticky_atc %}<div class="sticky-atc" data-sticky-atc><span><strong>{{ marketing_title | strip }}</strong><small class="price"><span class="money" data-sticky-price>{{ initial_variant.price | money }}</span></small></span><button class="button" type="button" data-sticky-submit>Add to cart</button></div>{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ marketing_title | strip | json }},
  "description": {{ marketing_summary | strip | json }},
  "url": {{ shop.url | append: product.url | json }},
  {% if product.featured_image %}"image": [{{ product.featured_image | image_url: width: 1600 | prepend: "https:" | json }}],{% endif %}
  "sku": {{ product.selected_or_first_available_variant.sku | default: product.selected_or_first_available_variant.id | json }},
  "brand": {
    "@type": "Brand",
    "name": "KROZO"
  },
  {% if real_rating_value != blank and real_review_count_number > 0 %}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ real_rating_value | json }},
    "reviewCount": {{ real_review_count | json }}
  },
  {% endif %}
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
    "price": {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{% if product.selected_or_first_available_variant.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": {{ shop.url | append: product.url | json }}
  }
}
</script>
{% schema %}
{"name":"Main product","settings":[{"type":"header","content":"Product content"},{"type":"checkbox","id":"show_ratings_summary","label":"Show ratings summary","default":true},{"type":"checkbox","id":"show_mock_social_proof","label":"Show layout preview in the theme editor only","default":true},{"type":"checkbox","id":"show_purchase_count","label":"Show purchase count from product metafield","default":true},{"type":"checkbox","id":"show_benefits","label":"Show benefit blocks","default":true},{"type":"checkbox","id":"show_trust_badges","label":"Show trust badges","default":true},{"type":"checkbox","id":"show_dynamic_checkout","label":"Show dynamic checkout/payment button","default":true},{"type":"checkbox","id":"show_sticky_atc","label":"Show mobile sticky add to cart","default":true},{"type":"header","content":"Editorial copy"},{"type":"text","id":"description_eyebrow","label":"Description eyebrow","default":"WHY IT BELONGS IN YOUR ROUTINE"},{"type":"text","id":"description_heading","label":"Description heading","default":"Designed around the moments that matter."}],"blocks":[{"type":"@app"},{"type":"benefit","name":"Benefit","limit":4,"settings":[{"type":"text","id":"text","label":"Benefit text","default":"Thoughtfully chosen for easier everyday routines"}]}]}
{% endschema %}
