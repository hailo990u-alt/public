<article class="section article-page"><header><span class="eyebrow">THE KROZO JOURNAL</span><h1>{{ article.title }}</h1><p>{% if article.tags.first %}{{ article.tags.first }} · {% endif %}{{ article.published_at | date: '%B %d, %Y' }} · {{ article.content | strip_html | size | divided_by: 900 | plus: 1 }} min read</p></header>{% if article.image != blank %}{{ article.image | image_url: width: 1800 | image_tag: loading: 'eager', alt: article.title }}{% endif %}<div class="rte">{{ article.content }}</div><footer class="article-footer"><strong>Thoughtful essentials for better everyday routines.</strong><a class="button" href="{{ routes.all_products_collection_url }}">Explore KROZO</a></footer></article>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BlogPosting","headline":{{ article.title | json }},"description":{{ article.excerpt_or_content | strip_html | truncate: 220 | json }},"datePublished":{{ article.published_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},"dateModified":{{ article.updated_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},"mainEntityOfPage":{{ canonical_url | json }}{% if article.image != blank %},"image":[{{ article.image | image_url: width: 1600 | prepend: "https:" | json }}]{% endif %},"publisher":{"@type":"Organization","name":{{ shop.name | json }}}}</script>
{% schema %}{"name":"Main article","settings":[]}{% endschema %}
