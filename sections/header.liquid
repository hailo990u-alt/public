{% assign dog_url = routes.search_url | append: '?q=dog&type=product' %}
{% assign cat_url = routes.search_url | append: '?q=cat&type=product' %}
{% assign best_sellers_url = routes.root_url | append: '#best-sellers' %}
{% assign journal_url = '/blogs/news' %}
{% assign contact_url = '/pages/contact' %}
{% assign story_url = routes.root_url | append: '#our-standard' %}
{% assign feeding_url = routes.all_products_collection_url %}
{% assign play_url = routes.all_products_collection_url %}
{% assign travel_url = routes.all_products_collection_url %}
{% assign care_url = routes.all_products_collection_url %}
{% assign shipping_url = '/pages/shipping-handling' %}
{% assign returns_url = '/pages/returns-refunds' %}
{% if collections['dog'] != blank %}{% assign dog_url = collections['dog'].url %}{% endif %}
{% if collections['dogs'] != blank %}{% assign dog_url = collections['dogs'].url %}{% endif %}
{% if collections['cat'] != blank %}{% assign cat_url = collections['cat'].url %}{% endif %}
{% if collections['cats'] != blank %}{% assign cat_url = collections['cats'].url %}{% endif %}
{% if collections['best-sellers'] != blank %}{% assign best_sellers_url = collections['best-sellers'].url %}{% endif %}
{% if pages['about-us'] != blank %}{% assign story_url = pages['about-us'].url %}{% elsif pages['why-krozo'] != blank %}{% assign story_url = pages['why-krozo'].url %}{% endif %}
{% if collections['smart-feeding'] != blank %}{% assign feeding_url = collections['smart-feeding'].url %}{% endif %}
{% if collections['toys'] != blank %}{% assign play_url = collections['toys'].url %}{% endif %}
{% if collections['travel-essentials'] != blank %}{% assign travel_url = collections['travel-essentials'].url %}{% endif %}
{% if collections['pure-care'] != blank %}{% assign care_url = collections['pure-care'].url %}{% endif %}
{% if shop.shipping_policy != blank %}{% assign shipping_url = shop.shipping_policy.url %}{% elsif pages['shipping-handling'] != blank %}{% assign shipping_url = pages['shipping-handling'].url %}{% endif %}
{% if pages['returns-refunds'] != blank %}{% assign returns_url = pages['returns-refunds'].url %}{% endif %}
{% if blogs['journal'] != blank %}{% assign journal_url = blogs['journal'].url %}{% elsif blogs['pet-care-journal'] != blank %}{% assign journal_url = blogs['pet-care-journal'].url %}{% elsif blogs['news'] != blank %}{% assign journal_url = blogs['news'].url %}{% endif %}
{% if pages['contact'] != blank %}{% assign contact_url = pages['contact'].url %}{% endif %}
{% if section.settings.show_announcement %}<div class="announcement">{% if section.settings.announcement_link != blank %}<a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement }}</a>{% else %}{{ section.settings.announcement }}{% endif %}</div>{% endif %}
<header class="site-header" style="--header-logo-desktop:{{ section.settings.logo_width_desktop }}px;--header-logo-mobile:{{ section.settings.logo_width_mobile }}px;">
  <button class="mobile-menu icon-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="MobileNavigation" data-menu-toggle>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  </button>
  <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
    {% if section.settings.logo != blank %}
      {{ section.settings.logo | image_url: width: 600 | image_tag: class: 'brand-logo', alt: shop.name }}
    {% else %}
      <img class="brand-logo" src="{{ 'krozo-logo-transparent.webp' | asset_url }}" alt="{{ shop.name }}" width="840" height="800" fetchpriority="high">
    {% endif %}
  </a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {% if section.settings.use_custom_menu and section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
    {% else %}
      <a href="{{ routes.all_products_collection_url }}">Shop All</a>
      <a href="{{ dog_url }}">Dogs</a>
      <a href="{{ cat_url }}">Cats</a>
      <a href="{{ routes.root_url }}#best-sellers">Best Sellers</a>
      <a href="{{ routes.root_url }}#our-standard">Our Standard</a>
      <a href="{{ journal_url }}">Journal</a>
      <a href="/pages/faq">FAQs</a>
      <a href="{{ contact_url }}">Help</a>
    {% endif %}
  </nav>
  <div class="header-actions">
    <a class="header-action" href="{{ routes.search_url }}" aria-label="Search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg><span>Search</span>
    </a>
    <a class="header-action" href="{{ routes.account_url }}" aria-label="Account">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5.5 20c.7-4 3-6 6.5-6s5.8 2 6.5 6"/></svg><span>Account</span>
    </a>
    <a class="header-action header-action--cart" href="{{ routes.cart_url }}" aria-label="Cart">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8.5h11l1 11h-13l1-11Z"/><path d="M9 9V6.5a3 3 0 0 1 6 0V9"/></svg><span>Bag</span><sup>{{ cart.item_count }}</sup>
    </a>
  </div>
</header>
<div class="mobile-nav-shell" data-mobile-nav-shell hidden>
  <button class="mobile-nav-overlay" type="button" aria-label="Close menu" data-menu-close></button>
  <nav id="MobileNavigation" class="mobile-nav" data-mobile-nav aria-label="Mobile navigation">
    <div class="mobile-nav__head">
      <span class="eyebrow">{{ section.settings.drawer_heading }}</span>
      <button class="icon-button mobile-nav__close" type="button" aria-label="Close menu" data-menu-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div class="mobile-nav__links">
      {% if section.settings.use_custom_menu and section.settings.menu != blank %}
        {% for link in section.settings.menu.links limit: 5 %}<a href="{{ link.url }}"><span>{{ link.title }}</span><span aria-hidden="true">→</span></a>{% endfor %}
      {% else %}
        <a href="{{ routes.all_products_collection_url }}"><span>Shop</span><span aria-hidden="true">→</span></a>
        <a href="{{ dog_url }}"><span>Dogs</span><span aria-hidden="true">→</span></a>
        <a href="{{ cat_url }}"><span>Cats</span><span aria-hidden="true">→</span></a>
        <a href="{{ best_sellers_url }}"><span>Best Sellers</span><span aria-hidden="true">→</span></a>
        <a href="{{ story_url }}"><span>{{ 'navigation.our_story' | t }}</span><span aria-hidden="true">→</span></a>
      {% endif %}
    </div>
    <div class="mobile-nav__discover" aria-labelledby="MobileDiscoverTitle">
      <p id="MobileDiscoverTitle" class="mobile-nav__help-title">{{ 'navigation.shop_by_need' | t }}</p>
      <div class="mobile-nav__quick-links">
        <a href="{{ feeding_url }}">{{ 'navigation.feeding_hydration' | t }}<span aria-hidden="true">→</span></a>
        <a href="{{ play_url }}">{{ 'navigation.play_enrichment' | t }}<span aria-hidden="true">→</span></a>
        <a href="{{ travel_url }}">{{ 'navigation.walk_travel' | t }}<span aria-hidden="true">→</span></a>
        <a href="{{ care_url }}">{{ 'navigation.wellness_care' | t }}<span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="mobile-nav__help" aria-labelledby="MobileHelpTitle">
      <p id="MobileHelpTitle" class="mobile-nav__help-title">{{ 'navigation.need_help' | t }}</p>
      <div class="mobile-nav__help-links">
        <a href="{{ shipping_url }}">{{ 'navigation.shipping_delivery' | t }}</a>
        <a href="{{ returns_url }}">{{ 'navigation.returns_refunds' | t }}</a>
        <a href="/pages/faq">{{ 'navigation.faqs' | t }}</a>
        <a href="{{ journal_url }}">{{ 'navigation.pet_care_journal' | t }}</a>
        <a href="{{ contact_url }}">{{ 'navigation.contact_support' | t }}</a>
      </div>
    </div>
    <div class="mobile-nav__footer">{% if section.blocks.size > 0 %}{% for block in section.blocks %}<span {{ block.shopify_attributes }}><strong>{{ block.settings.text }}</strong><small>{{ block.settings.subtext }}</small></span>{% endfor %}{% else %}<strong>Complimentary shipping</strong><small>On every KROZO order</small>{% endif %}</div>
  </nav>
</div>
<div class="global-trust-bar" aria-label="Store guarantees">{% if section.blocks.size > 0 %}{% for block in section.blocks %}<span {{ block.shopify_attributes }}>{{ block.settings.icon }} {{ block.settings.text }}</span>{% endfor %}{% else %}<span>✓ Secure checkout</span><span>✓ Free shipping</span><span>✓ 30-day returns</span><span>✓ Shopify-powered payments</span>{% endif %}</div>
{% schema %}
{"name":"Krozo header","settings":[{"type":"header","content":"Announcement"},{"type":"checkbox","id":"show_announcement","label":"Show announcement","default":true},{"type":"text","id":"announcement","label":"Announcement","default":"FREE SHIPPING · 10% OFF $50+ WITH CODE KROZO10"},{"type":"url","id":"announcement_link","label":"Announcement link"},{"type":"header","content":"Logo and navigation"},{"type":"image_picker","id":"logo","label":"Logo"},{"type":"range","id":"logo_width_desktop","min":80,"max":220,"step":2,"unit":"px","label":"Desktop logo width","default":126},{"type":"range","id":"logo_width_mobile","min":70,"max":160,"step":2,"unit":"px","label":"Mobile logo width","default":100},{"type":"checkbox","id":"use_custom_menu","label":"Use Shopify navigation menu","default":false},{"type":"link_list","id":"menu","label":"Custom menu","default":"main-menu"},{"type":"text","id":"drawer_heading","label":"Drawer heading","default":"EXPLORE KROZO"}],"blocks":[{"type":"trust_item","name":"Trust item","limit":4,"settings":[{"type":"text","id":"icon","label":"Icon","default":"✓"},{"type":"text","id":"text","label":"Text","default":"Secure checkout"},{"type":"text","id":"subtext","label":"Drawer subtext","default":"Shop with confidence"}]}],"presets":[{"name":"Krozo header"}]}
{% endschema %}
