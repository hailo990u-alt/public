<section class="section catalogue-page">
  <div class="section-title"><span class="eyebrow">THE KROZO COLLECTION</span><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="collection-description">{{ collection.description }}</div>{% endif %}</div>
  {% paginate collection.products by 24 %}
    <div class="product-grid">
      {% for product in collection.products %}
        {% capture marketing_title %}{% render 'krozo-product-title', product: product %}{% endcapture %}
        <article class="product-card">
          <a href="{{ product.url }}" class="product-image">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}{% if product.compare_at_price > product.price %}<span class="badge">SAVE {{ product.compare_at_price | minus: product.price | money }}</span>{% endif %}</a>
          <div class="product-info">{% if product.metafields.reviews.rating.value != blank %}<div class="stars">★★★★★ <span>({{ product.metafields.reviews.rating_count }})</span></div>{% endif %}{% if product.metafields.custom.purchases_count != blank %}<div class="purchase-count">{{ product.metafields.custom.purchases_count }}+ purchased</div>{% endif %}<a href="{{ product.url }}"><h3>{{ marketing_title | strip }}</h3></a><p class="product-card__benefit">{% render 'krozo-product-summary', product: product %}</p><p>{{ product.price | money }} {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</p><a class="quick-add" href="{{ product.url }}">View product</a></div>
        </article>
      {% else %}<p>No products have been added to this collection yet.</p>{% endfor %}
    </div>
    {{ paginate | default_pagination }}
  {% endpaginate %}
</section>
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
