{% assign collection_handle = collection.handle | downcase %}
{% assign show_layout_preview = false %}
{% if section.settings.show_sample_social_proof %}{% assign show_layout_preview = true %}{% endif %}
{% assign hero_eyebrow = 'THE KROZO COLLECTION' %}
{% assign hero_title = collection.title %}
{% assign hero_text = 'Thoughtfully selected essentials for calmer routines, happier pets and homes that still feel beautifully yours.' %}
{% assign hero_note = 'Considered design · Pet-first function · Everyday ease' %}
{% if collection_handle == 'all' %}
  {% assign hero_eyebrow = 'EVERYDAY ESSENTIALS' %}
  {% assign hero_title = 'Better routines start here.' %}
  {% assign hero_text = 'Explore the complete KROZO edit—useful, considered products chosen to make everyday life with your pet feel simpler.' %}
{% elsif collection_handle contains 'dog' %}
  {% assign hero_eyebrow = 'FOR DOGS' %}
  {% assign hero_title = 'Made for walks, meals and everything between.' %}
  {% assign hero_text = 'Practical essentials for calmer mealtimes, easier outings and more rewarding everyday moments with your dog.' %}
  {% assign hero_note = 'Walk · Feed · Play · Care' %}
{% elsif collection_handle contains 'cat' %}
  {% assign hero_eyebrow = 'FOR CATS' %}
  {% assign hero_title = 'Designed for curious, comfortable lives.' %}
  {% assign hero_text = 'Enrichment, comfort and care essentials selected around the instincts and routines that help cats thrive.' %}
  {% assign hero_note = 'Scratch · Play · Rest · Care' %}
{% elsif collection_handle contains 'feed' %}
  {% assign hero_eyebrow = 'FEEDING & HYDRATION' %}
  {% assign hero_title = 'Calmer meals. Easier clean-up.' %}
  {% assign hero_text = 'Bowls, travel hydration and feeding tools chosen to make daily routines more comfortable and considered.' %}
{% elsif collection_handle contains 'travel' or collection_handle contains 'walk' %}
  {% assign hero_eyebrow = 'WALK & TRAVEL' %}
  {% assign hero_title = 'Ready whenever you are.' %}
  {% assign hero_text = 'Compact, practical companions for daily walks, road trips and unplanned adventures together.' %}
{% elsif collection_handle contains 'play' %}
  {% assign hero_eyebrow = 'PLAY & ENRICHMENT' %}
  {% assign hero_title = 'More engagement. Better everyday moments.' %}
  {% assign hero_text = 'Purposeful play essentials that support natural instincts and help prevent boredom.' %}
{% elsif collection_handle contains 'health' or collection_handle contains 'wellness' %}
  {% assign hero_eyebrow = 'WELLNESS & CARE' %}
  {% assign hero_title = 'Small acts of care, made simpler.' %}
  {% assign hero_text = 'Gentle, practical tools for the routines that help your pet feel comfortable, clean and cared for.' %}
{% endif %}

<section class="catalogue-hero">
  {% assign hero_image = collection.image %}
  {% if collection_handle == 'all' and section.settings.shop_all_hero_image != blank %}
    {% assign hero_image = section.settings.shop_all_hero_image %}
  {% endif %}
  {% if collection_handle == 'dogs' %}
    <div class="catalogue-hero__media"><img src="{{ 'krozo-category-wellness.webp' | asset_url }}" alt="Dog enjoying a calm KROZO care routine" width="1000" height="1000" loading="eager"></div>
  {% elsif collection_handle == 'cats' %}
    <div class="catalogue-hero__media"><img src="{{ 'krozo-category-play.webp' | asset_url }}" alt="Cat playing with a thoughtfully designed scratcher" width="1000" height="1000" loading="eager"></div>
  {% elsif hero_image != blank %}
    <div class="catalogue-hero__media">{{ hero_image | image_url: width: 1800 | image_tag: loading: 'eager', alt: hero_title }}</div>
  {% elsif collection_handle == 'all' %}
    <div class="catalogue-hero__media"><img src="https://cdn.shopify.com/s/files/1/0743/6143/8297/files/krozo-shop-all-hero.png?v=1785433578" alt="{{ hero_title | escape }}" width="1664" height="936" loading="eager"></div>
  {% elsif collection.products.first.featured_image != blank %}
    <div class="catalogue-hero__media">{{ collection.products.first.featured_image | image_url: width: 1800 | image_tag: loading: 'eager', alt: hero_title }}</div>
  {% endif %}
  <div class="catalogue-hero__content">
    <span class="eyebrow">{{ hero_eyebrow }}</span>
    <h1>{{ hero_title }}</h1>
    <p>{{ hero_text }}</p>
    <small>{{ hero_note }}</small>
  </div>
</section>

<nav class="collection-tabs" aria-label="Shop by collection">
  <a href="{{ routes.all_products_collection_url }}" {% if collection_handle == 'all' %}aria-current="page"{% endif %}>Shop All</a>
  <a href="{% if collections['dogs'] != blank %}{{ collections['dogs'].url }}{% elsif collections['dog'] != blank %}{{ collections['dog'].url }}{% else %}{{ routes.search_url }}?q=dog&type=product{% endif %}" {% if collection_handle contains 'dog' %}aria-current="page"{% endif %}>Dogs</a>
  <a href="{% if collections['cats'] != blank %}{{ collections['cats'].url }}{% elsif collections['cat'] != blank %}{{ collections['cat'].url }}{% else %}{{ routes.search_url }}?q=cat&type=product{% endif %}" {% if collection_handle contains 'cat' %}aria-current="page"{% endif %}>Cats</a>
  <a href="{% if collections['smart-feeding'] != blank %}{{ collections['smart-feeding'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" {% if collection_handle == 'smart-feeding' %}aria-current="page"{% endif %}>Feeding</a>
  <a href="{% if collections['toys'] != blank %}{{ collections['toys'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" {% if collection_handle == 'toys' %}aria-current="page"{% endif %}>Play</a>
  <a href="{% if collections['travel-essentials'] != blank %}{{ collections['travel-essentials'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" {% if collection_handle == 'travel-essentials' %}aria-current="page"{% endif %}>Travel</a>
  <a href="{% if collections['pure-care'] != blank %}{{ collections['pure-care'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" {% if collection_handle == 'pure-care' %}aria-current="page"{% endif %}>Care</a>
</nav>

<section class="section catalogue-page" style="--product-card-ratio:{{ section.settings.image_ratio }};">
  <div class="catalogue-toolbar">
    <div><span class="eyebrow">{{ section.settings.toolbar_eyebrow }}</span><h2>{{ collection.products_count }} thoughtful {% if collection.products_count == 1 %}essential{% else %}essentials{% endif %}</h2></div>
    <label>Sort by
      <select data-collection-sort>
        {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
        {% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}
      </select>
    </label>
  </div>
  {% paginate collection.products by 24 %}
    <div class="catalogue-grid">
      {% for product in collection.products %}
        {% capture marketing_title %}{% render 'krozo-product-title', product: product %}{% endcapture %}
        {% assign rating_value = product.metafields.reviews.rating.value %}
        {% assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count %}
        {% assign rating_number = rating_value.rating | default: rating_value.value | default: rating_value %}
        {% assign rating_count_number = rating_count | plus: 0 %}
        {% assign judgeme_data = product.metafields.judgeme.review_widget_data.value %}
        {% assign judgeme_review_count = judgeme_data.number_of_reviews | plus: 0 %}
        {% if judgeme_review_count > 0 %}{% assign rating_number = judgeme_data.average_rating %}{% assign rating_count = judgeme_review_count %}{% assign rating_count_number = judgeme_review_count %}{% endif %}
        {% assign purchase_count = product.metafields.custom.purchases_count.value | default: product.metafields.custom.purchases_count %}
        {% assign sample_seed = product.id | modulo: 5 %}
        {% assign sample_rating_count = product.id | modulo: 137 | plus: 43 %}
        {% assign sample_purchase_count = product.id | modulo: 389 | plus: 126 %}
        {% case sample_seed %}
          {% when 0 %}{% assign sample_rating = '4.8' %}
          {% when 1 %}{% assign sample_rating = '4.9' %}
          {% when 2 %}{% assign sample_rating = '4.7' %}
          {% when 3 %}{% assign sample_rating = '4.8' %}
          {% else %}{% assign sample_rating = '4.6' %}
        {% endcase %}
        <article class="catalogue-card">
          <a href="{{ product.url }}" class="catalogue-card__media">
            {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: marketing_title }}{% endif %}
            {% if section.settings.show_badges and product.compare_at_price > product.price %}<span class="badge">SAVE {{ product.compare_at_price | minus: product.price | money }}</span>{% endif %}
            {% if section.settings.show_badges %}{% unless product.available %}<span class="badge badge--right">SOLD OUT</span>{% endunless %}{% endif %}
          </a>
          <div class="catalogue-card__body">
            {% if section.settings.show_ratings and show_layout_preview %}
              <a class="catalogue-card__rating" href="{{ product.url }}#reviews"><span>★★★★★</span><strong>{{ sample_rating }}</strong><small>{{ sample_rating_count }} reviews</small></a>
            {% elsif section.settings.show_ratings and rating_number != blank and rating_count_number > 0 %}
              <a class="catalogue-card__rating" href="{{ product.url }}#reviews"><span>★★★★★</span><strong>{{ rating_number | round: 1 }}</strong><small>{{ rating_count }} {% if rating_count_number == 1 %}review{% else %}reviews{% endif %}</small></a>
            {% elsif section.settings.show_ratings %}
              <a class="catalogue-card__rating catalogue-card__rating--empty" href="{{ product.url }}#reviews"><span>☆☆☆☆☆</span><small>Write the first review</small></a>
            {% endif %}
            {% if section.settings.show_purchase_count and show_layout_preview %}
              <div class="purchase-count">{{ sample_purchase_count }}+ purchased</div>
            {% elsif section.settings.show_purchase_count and purchase_count != blank %}
              <div class="purchase-count">{{ purchase_count }} purchased</div>
            {% endif %}
            <a href="{{ product.url }}"><h3>{{ marketing_title | strip }}</h3></a>
            <p class="catalogue-card__benefit">{% render 'krozo-product-summary', product: product %}</p>
            <div class="catalogue-card__buy">
              <p>{{ product.price | money }} {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</p>
              {% if section.settings.show_quick_add and product.available and product.has_only_default_variant %}
                {% form 'product', product, class: 'card-atc-form' %}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" aria-label="Add {{ marketing_title | strip | escape }} to cart">Add to bag</button>
                {% endform %}
              {% else %}
                <a href="{{ product.url }}">Choose options</a>
              {% endif %}
            </div>
          </div>
        </article>
      {% else %}
        <div class="catalogue-empty"><span class="eyebrow">COMING SOON</span><h2>We are curating this collection.</h2><p>Each KROZO product is considered carefully before it joins the edit.</p><a class="button" href="{{ routes.all_products_collection_url }}">Shop all essentials</a></div>
      {% endfor %}
    </div>
    <div class="catalogue-pagination">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
</section>

<section class="collection-confidence">
  <article><strong>Complimentary shipping</strong><span>On every order</span></article>
  <article><strong>30-day returns</strong><span>Simple return requests</span></article>
  <article><strong>Secure checkout</strong><span>Shopify-powered payments</span></article>
  <article><strong>Helpful support</strong><span>Before and after ordering</span></article>
</section>

<script>
  document.addEventListener('change',function(event){
    if(!event.target.matches('[data-collection-sort]'))return;
    var url=new URL(window.location.href);
    url.searchParams.set('sort_by',event.target.value);
    window.location.assign(url.toString());
  });
</script>
{% schema %}{"name":"Modern collection","settings":[{"type":"image_picker","id":"shop_all_hero_image","label":"Shop All hero image"},{"type":"text","id":"toolbar_eyebrow","label":"Toolbar eyebrow","default":"CURATED FOR REAL LIFE"},{"type":"select","id":"image_ratio","label":"Product card image ratio","default":"auto","options":[{"value":"auto","label":"Theme default"},{"value":"1 / 1","label":"Square"},{"value":"4 / 5","label":"Portrait"}]},{"type":"checkbox","id":"show_badges","label":"Show badges","default":true},{"type":"checkbox","id":"show_ratings","label":"Show real ratings","default":true},{"type":"checkbox","id":"show_purchase_count","label":"Show purchase count from metafield","default":true},{"type":"checkbox","id":"show_quick_add","label":"Show quick add","default":true},{"type":"checkbox","id":"show_sample_social_proof","label":"Show layout previews in theme editor","default":true}]}{% endschema %}
