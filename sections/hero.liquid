{% unless section.settings.hide_section %}
{% assign hero_image = section.settings.image | default: 'krozo-hero-lifestyle.png' %}
<section class="hero" style="text-align:{{ section.settings.text_alignment }};color:{{ section.settings.text_color | default: settings.color_text }};background-color:{{ section.settings.background_color | default: settings.color_surface_background }};background-position:{{ section.settings.image_position }};background-image:linear-gradient(90deg,rgba(239,233,220,.97) 0%,rgba(239,233,220,.83) 42%,rgba(239,233,220,.08) 73%),url('{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2200 }}{% else %}{{ hero_image | asset_url }}{% endif %}')">
  <div class="hero-content">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <div class="button-row"><a class="button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a><a class="button button--outline" href="{{ section.settings.secondary_link | default: '#collections' }}">{{ section.settings.secondary_label }}</a></div>
    <div class="trust-line"><span>Free Shipping</span><span>30-Day Returns</span><span>Secure Checkout</span><span>Fast Support</span></div>
  </div>
</section>
{% endunless %}
{% schema %}{"name":"Krozo hero","settings":[{"type":"checkbox","id":"hide_section","label":"Hide section","default":false},{"type":"header","content":"Content"},{"type":"image_picker","id":"image","label":"Lifestyle image"},{"type":"select","id":"image_position","label":"Image focal position","default":"center center","options":[{"value":"center center","label":"Center"},{"value":"left center","label":"Left"},{"value":"right center","label":"Right"}]},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MADE FOR THE LIFE YOU SHARE"},{"type":"text","id":"heading","label":"Heading","default":"Premium essentials for pets who deserve the best."},{"type":"textarea","id":"text","label":"Text","default":"Thoughtfully designed pieces that bring more comfort, calm, and joy to everyday life with your pet."},{"type":"text","id":"primary_label","label":"Primary button","default":"Shop Best Sellers"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Explore Collection"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"header","content":"Style"},{"type":"select","id":"text_alignment","label":"Text alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}]},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"}]}{% endschema %}
