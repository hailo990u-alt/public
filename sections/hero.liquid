{% assign hero_image = section.settings.image | default: 'krozo-hero-lifestyle.png' %}
<section class="hero" style="background-image:linear-gradient(90deg,rgba(239,233,220,.97) 0%,rgba(239,233,220,.83) 42%,rgba(239,233,220,.08) 73%),url('{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2200 }}{% else %}{{ hero_image | asset_url }}{% endif %}')">
  <div class="hero-content">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <div class="button-row"><a class="button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a><a class="button button--outline" href="{{ section.settings.secondary_link | default: '#collections' }}">{{ section.settings.secondary_label }}</a></div>
    <div class="trust-line"><span>Free Shipping</span><span>30-Day Returns</span><span>Secure Checkout</span><span>Fast Support</span></div>
  </div>
</section>
{% schema %}{"name":"Krozo hero","settings":[{"type":"image_picker","id":"image","label":"Lifestyle image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MADE FOR THE LIFE YOU SHARE"},{"type":"text","id":"heading","label":"Heading","default":"Premium essentials for pets who deserve the best."},{"type":"textarea","id":"text","label":"Text","default":"Thoughtfully designed pieces that bring more comfort, calm, and joy to everyday life with your pet."},{"type":"text","id":"primary_label","label":"Primary button","default":"Shop Best Sellers"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Explore Collection"},{"type":"url","id":"secondary_link","label":"Secondary link"}]}{% endschema %}
