<section class="section">
  <div class="section-title"><span class="eyebrow">THE KROZO DIFFERENCE</span><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>
  <div class="value-grid">
    {% for block in section.blocks %}
      <article {{ block.shopify_attributes }}>
        <span class="value-icon" aria-hidden="true">
          {% case forloop.index %}
            {% when 1 %}<svg viewBox="0 0 48 48"><path d="M24 4 39 10v10c0 10-6 17-15 22C15 37 9 30 9 20V10l15-6Z"/><path d="m17 24 5 5 10-12"/></svg>
            {% when 2 %}<svg viewBox="0 0 48 48"><path d="m24 5 17 19-17 19L7 24 24 5Z"/><path d="M15 24h18M24 14v20"/></svg>
            {% when 3 %}<svg viewBox="0 0 48 48"><path d="M24 41S7 32 7 18c0-6 4-10 9-10 4 0 7 2 8 6 1-4 4-6 8-6 5 0 9 4 9 10 0 14-17 23-17 23Z"/><path d="M18 24h12"/></svg>
            {% else %}<svg viewBox="0 0 48 48"><path d="m24 5 4.8 11.5L41 18l-9 8 2.5 12-10.5-6-10.5 6L16 26l-9-8 12.2-1.5L24 5Z"/></svg>
          {% endcase %}
        </span>
        <h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p>
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}{"name":"Value propositions","settings":[{"type":"text","id":"heading","label":"Heading","default":"Designed with care, made to last."},{"type":"textarea","id":"text","label":"Text","default":"Every detail is considered so you can spend less time worrying and more time together."}],"blocks":[{"type":"value","name":"Value","settings":[{"type":"text","id":"icon","label":"Legacy icon","default":"♡"},{"type":"text","id":"heading","label":"Heading","default":"Premium Materials"},{"type":"textarea","id":"text","label":"Text","default":"Exceptionally soft, durable materials selected for everyday comfort."}]}],"presets":[{"name":"Value propositions","blocks":[{"type":"value"},{"type":"value","settings":{"heading":"Thoughtful Design"}},{"type":"value","settings":{"heading":"Pet-First Care"}},{"type":"value","settings":{"heading":"Loved by Pet Parents"}}]}]}{% endschema %}
