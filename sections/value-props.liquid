<section class="section"><div class="section-title"><span class="eyebrow">THE KROZO DIFFERENCE</span><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><div class="value-grid">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span class="value-icon">{{ block.settings.icon }}</span><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div></section>
{% schema %}{"name":"Value propositions","settings":[{"type":"text","id":"heading","label":"Heading","default":"Designed with care, made to last."},{"type":"textarea","id":"text","label":"Text","default":"Every detail is considered so you can spend less time worrying and more time together."}],"blocks":[{"type":"value","name":"Value","settings":[{"type":"text","id":"icon","label":"Icon","default":"♡"},{"type":"text","id":"heading","label":"Heading","default":"Premium Materials"},{"type":"textarea","id":"text","label":"Text","default":"Exceptionally soft, durable materials selected for everyday comfort."}]}],"presets":[{"name":"Value propositions","blocks":[{"type":"value"},{"type":"value","settings":{"icon":"◇","heading":"Thoughtful Design"}},{"type":"value","settings":{"icon":"✓","heading":"Pet-First Care"}},{"type":"value","settings":{"icon":"✦","heading":"Loved by Pet Parents"}}]}]}{% endschema %}
