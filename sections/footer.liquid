<footer class="site-footer">
  <div class="footer-newsletter"><div><span class="eyebrow">THE KROZO LETTER</span><h3>Thoughtful pet care, delivered gently.</h3><p>Product guidance, everyday ideas and new arrivals—without the noise.</p></div>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="FooterEmail">Email address</label><input id="FooterEmail" type="email" name="contact[email]" placeholder="Your email address" required><button type="submit">Join the list →</button>{% endform %}</div>
  <div class="footer-grid">
    <div>{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 500 | image_tag: class: 'footer-logo', alt: shop.name }}{% else %}<img class="footer-logo" src="{{ 'krozo-logo-transparent.png' | asset_url }}" alt="{{ shop.name }}" width="840" height="800">{% endif %}<p>{{ section.settings.blurb }}</p><div class="footer-confidence"><span>Secure Shopify checkout</span><span>Free shipping</span><span>30-day returns</span></div></div>
    <div><h4>SHOP</h4><a href="{{ routes.all_products_collection_url }}">All products</a><a href="{% if collections['dog'] != blank %}{{ collections['dog'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">For dogs</a><a href="{% if collections['cat'] != blank %}{{ collections['cat'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">For cats</a><a href="{% if collections['travel'] != blank %}{{ collections['travel'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">Travel essentials</a></div>
    <div><h4>HELP</h4><a href="/pages/contact">Contact us</a><a href="{% if shop.shipping_policy != blank %}{{ shop.shipping_policy.url }}{% else %}/policies/shipping-policy{% endif %}">Shipping</a><a href="{% if shop.refund_policy != blank %}{{ shop.refund_policy.url }}{% else %}/policies/refund-policy{% endif %}">Returns</a><a href="{{ routes.root_url }}#faq">FAQs</a></div>
    <div><h4>ABOUT & LEGAL</h4><a href="/pages/about-us">Our story</a><a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy</a><a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms</a><a href="/pages/contact">Contact information</a></div>
  </div>
  <div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span><span>Secure payments · Thoughtful support · Made for life with pets</span></div>
</footer>
{% schema %}{"name":"Krozo footer","settings":[{"type":"image_picker","id":"logo","label":"Full logo"},{"type":"textarea","id":"blurb","label":"Brand description","default":"Thoughtfully designed essentials for a more beautiful life with pets."}],"blocks":[{"type":"link_list","name":"Link column","settings":[{"type":"text","id":"heading","label":"Heading","default":"Help"},{"type":"link_list","id":"menu","label":"Menu","default":"footer"}]}],"max_blocks":3}{% endschema %}
