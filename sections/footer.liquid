<footer class="site-footer"><div class="footer-grid"><div>{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 500 | image_tag: class: 'footer-logo', alt: shop.name }}{% else %}<img class="footer-logo" src="{{ 'krozo-logo-transparent.png' | asset_url }}" alt="{{ shop.name }}" width="840" height="800">{% endif %}<p>{{ section.settings.blurb }}</p></div>{% for block in section.blocks %}<div {{ block.shopify_attributes }}><h4>{{ block.settings.heading }}</h4>{% for link in block.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</div>{% endfor %}</div><div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span><span>{{ powered_by_link }}</span></div></footer>
{% schema %}{"name":"Krozo footer","settings":[{"type":"image_picker","id":"logo","label":"Full logo"},{"type":"textarea","id":"blurb","label":"Brand description","default":"Thoughtfully designed essentials for a more beautiful life with pets."}],"blocks":[{"type":"link_list","name":"Link column","settings":[{"type":"text","id":"heading","label":"Heading","default":"Help"},{"type":"link_list","id":"menu","label":"Menu","default":"footer"}]}],"max_blocks":3}{% endschema %}
