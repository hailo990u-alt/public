{% unless section.settings.hide_section %}
{% assign footer_year = 'now' | date: '%Y' %}
<footer class="site-footer">
  <div class="footer-newsletter"><div><span class="eyebrow">{{ section.settings.newsletter_eyebrow }}</span><h3>{{ section.settings.newsletter_heading }}</h3><p>{{ section.settings.newsletter_text }}</p></div>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="FooterEmail">Email address</label><input id="FooterEmail" type="email" name="contact[email]" placeholder="Your email address" required><button type="submit">{{ section.settings.newsletter_button }}</button>{% endform %}</div>
  <div class="footer-grid">
    <div>{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 500 | image_tag: class: 'footer-logo', alt: shop.name }}{% else %}<img class="footer-logo" src="{{ 'krozo-logo-transparent.png' | asset_url }}" alt="{{ shop.name }}" width="840" height="800">{% endif %}<p>{{ section.settings.blurb }}</p><div class="footer-confidence"><span>Secure Shopify checkout</span><span>Free shipping</span><span>30-day returns</span></div></div>
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}><h4>{{ block.settings.heading }}</h4>{% if block.settings.menu != blank %}{% for link in block.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% endif %}</div>
      {% endfor %}
    {% else %}
      <div><h4>SHOP</h4><a href="{{ routes.all_products_collection_url }}">All products</a><a href="{% if collections['dog'] != blank %}{{ collections['dog'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">For dogs</a><a href="{% if collections['cat'] != blank %}{{ collections['cat'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">For cats</a><a href="{% if collections['travel'] != blank %}{{ collections['travel'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">Travel essentials</a></div>
      <div><h4>HELP</h4><a href="/pages/contact">Contact us</a><a href="{% if shop.shipping_policy != blank %}{{ shop.shipping_policy.url }}{% else %}/policies/shipping-policy{% endif %}">Shipping</a><a href="{% if shop.refund_policy != blank %}{{ shop.refund_policy.url }}{% else %}/policies/refund-policy{% endif %}">Returns</a><a href="#faq-help" data-faq-open>FAQs</a></div>
      <div><h4>ABOUT & LEGAL</h4><a href="/pages/about-us">Our story</a><a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy</a><a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms</a><a href="/pages/contact">Contact information</a></div>
    {% endif %}
  </div>
  <div class="footer-bottom"><span>{{ section.settings.legal_text | replace: "[year]", footer_year }}</span><span>{{ section.settings.footer_note }}</span></div>
</footer>{% endunless %}
{% schema %}
{"name":"Krozo footer","settings":[{"type":"checkbox","id":"hide_section","label":"Hide footer","default":false},{"type":"header","content":"Newsletter"},{"type":"text","id":"newsletter_eyebrow","label":"Eyebrow","default":"THE KROZO LETTER"},{"type":"text","id":"newsletter_heading","label":"Heading","default":"Thoughtful pet care, delivered gently."},{"type":"textarea","id":"newsletter_text","label":"Text","default":"Product guidance, everyday ideas and new arrivals—without the noise."},{"type":"text","id":"newsletter_button","label":"Button text","default":"Join the list →"},{"type":"header","content":"Brand and legal"},{"type":"image_picker","id":"logo","label":"Full logo"},{"type":"textarea","id":"blurb","label":"Brand description","default":"Thoughtfully designed essentials for a more beautiful life with pets."},{"type":"text","id":"legal_text","label":"Legal text","default":"© [year] KROZO. All rights reserved."},{"type":"text","id":"footer_note","label":"Footer note","default":"Secure payments · Thoughtful support · Made for life with pets"},{"type":"url","id":"instagram_url","label":"Instagram URL"},{"type":"url","id":"tiktok_url","label":"TikTok URL"},{"type":"url","id":"facebook_url","label":"Facebook URL"}],"blocks":[{"type":"link_list","name":"Link column","settings":[{"type":"text","id":"heading","label":"Heading","default":"Help"},{"type":"link_list","id":"menu","label":"Menu","default":"footer"}]}],"max_blocks":3,"presets":[{"name":"Krozo footer"}]}
{% endschema %}
