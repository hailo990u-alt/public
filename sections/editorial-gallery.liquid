<section class="section editorial-gallery">
  <div class="section-title">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="editorial-gallery__grid">
    {% for block in section.blocks %}
      <figure class="editorial-gallery__item editorial-gallery__item--{{ forloop.index }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,700,1000,1200' }}
        {% elsif forloop.index == 1 %}
          <img src="{{ 'krozo-gallery-cat.png' | asset_url }}" loading="lazy" alt="A calm cat beside a ceramic feeding bowl">
        {% elsif forloop.index == 2 %}
          <img src="{{ 'krozo-hero-lifestyle.png' | asset_url }}" loading="lazy" alt="A happy dog in a warm modern home">
        {% else %}
          <img src="{{ 'krozo-lifestyle-banner.png' | asset_url }}" loading="lazy" alt="A pet parent sharing a quiet moment with their dog">
        {% endif %}
      </figure>
    {% endfor %}
  </div>
</section>

{% schema %}
{"name":"Editorial gallery","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"LIFE WITH KROZO"},{"type":"text","id":"heading","label":"Heading","default":"Made for beautiful everyday moments."}],"blocks":[{"type":"image","name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image"}]}],"max_blocks":5,"presets":[{"name":"Editorial gallery","blocks":[{"type":"image"},{"type":"image"},{"type":"image"}]}]}
{% endschema %}
