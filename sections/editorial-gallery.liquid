<section class="section editorial-gallery">
  <div class="section-title">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="editorial-gallery__grid">
    {% for block in section.blocks %}
      <figure class="editorial-gallery__item editorial-gallery__item--{{ forloop.index }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', decoding: 'async', widths: '320,480,700,900,1200', sizes: '(max-width: 750px) 76vw, 33vw' }}
        {% elsif forloop.index == 1 %}
          <img src="{{ 'krozo-gallery-cat.webp' | asset_img_url: '700x' }}" srcset="{{ 'krozo-gallery-cat.webp' | asset_img_url: '400x' }} 400w, {{ 'krozo-gallery-cat.webp' | asset_img_url: '700x' }} 700w, {{ 'krozo-gallery-cat.webp' | asset_img_url: '1000x' }} 1000w" sizes="(max-width: 750px) 76vw, 33vw" loading="lazy" decoding="async" alt="A calm cat beside a ceramic feeding bowl" width="1254" height="1254">
        {% elsif forloop.index == 2 %}
          <img src="{{ 'krozo-hero-lifestyle.png' | asset_img_url: '750x' }}" srcset="{{ 'krozo-hero-lifestyle.png' | asset_img_url: '480x' }} 480w, {{ 'krozo-hero-lifestyle.png' | asset_img_url: '750x' }} 750w, {{ 'krozo-hero-lifestyle.png' | asset_img_url: '1100x' }} 1100w" sizes="(max-width: 750px) 76vw, 40vw" loading="lazy" decoding="async" alt="A happy dog in a warm modern home" width="1672" height="941">
        {% else %}
          <img src="{{ 'krozo-lifestyle-banner.webp' | asset_url }}" sizes="(max-width: 750px) 76vw, 33vw" loading="lazy" decoding="async" alt="A pet parent sharing a quiet moment with their dog" width="1672" height="941">
        {% endif %}
      </figure>
    {% endfor %}
  </div>
</section>

{% schema %}
{"name":"Editorial gallery","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"LIFE WITH KROZO"},{"type":"text","id":"heading","label":"Heading","default":"Made for beautiful everyday moments."}],"blocks":[{"type":"image","name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image"}]}],"max_blocks":5,"presets":[{"name":"Editorial gallery","blocks":[{"type":"image"},{"type":"image"},{"type":"image"}]}]}
{% endschema %}
