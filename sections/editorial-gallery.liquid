<section class="editorial-gallery">
  <div class="editorial-gallery__heading">
    <p class="eyebrow">KROZO AT HOME</p>
    <h2>Calm spaces.<br>Happy companions.</h2>
  </div>
  <div class="editorial-gallery__grid">
    {% for block in section.blocks %}
      <div class="editorial-gallery__item editorial-gallery__item--{{ forloop.index }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '550,800,1100,1400', sizes: '(max-width: 920px) 100vw, 33vw' }}
        {% else %}
          {% assign fallback_backup_src = blank %}
          {% case forloop.index %}
            {% when 1 %}
              {% assign fallback_src = 'krozo-gallery-cat.webp' | asset_url %}
              {% assign fallback_backup_src = 'krozo-gallery-cat.png' | asset_img_url: '1200x' %}
              {% assign fallback_alt = 'A calm cat resting on a linen sofa' %}
            {% when 2 %}
              {% assign fallback_src = 'krozo-lifestyle-banner.png' | asset_img_url: '1200x' %}
              {% assign fallback_alt = 'A relaxed golden retriever at home' %}
            {% else %}
              {% assign fallback_src = 'krozo-lifestyle-banner.webp' | asset_url %}
              {% assign fallback_backup_src = 'krozo-lifestyle-banner.png' | asset_img_url: '1200x' %}
              {% assign fallback_alt = 'A quiet home moment with a pet' %}
          {% endcase %}
          <img
            src="{{ fallback_src }}"
            {% if fallback_backup_src != blank %}onerror="this.onerror=null;this.src='{{ fallback_backup_src }}';"{% endif %}
            loading="lazy"
            decoding="async"
            width="1200"
            height="1500"
            alt="{{ fallback_alt }}"
          >
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "KROZO editorial gallery",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {"type":"image_picker","id":"image","label":"Image"}
      ]
    }
  ],
  "presets": [
    {
      "name": "KROZO editorial gallery",
      "blocks": [{"type":"image"},{"type":"image"},{"type":"image"}]
    }
  ]
}
{% endschema %}
