<section class="journal-hero">
  <div><span class="eyebrow">THE KROZO JOURNAL</span><h1>Thoughtful guidance for life with pets.</h1><p>Practical, calm and carefully considered advice for feeding, enrichment, travel and everyday care.</p></div>
</section>
<nav class="journal-topics" aria-label="Journal topics">
  <a href="{{ blog.url }}">All guides</a>
  <a href="{{ blog.url }}/tagged/dog-care">Dog care</a>
  <a href="{{ blog.url }}/tagged/cat-care">Cat care</a>
  <a href="{{ blog.url }}/tagged/feeding">Feeding</a>
  <a href="{{ blog.url }}/tagged/enrichment">Enrichment</a>
  <a href="{{ blog.url }}/tagged/travel">Travel</a>
</nav>
<section class="section content-page journal-page">
  {% paginate blog.articles by 12 %}
    {% if blog.articles.size > 0 %}
      {% assign featured_article = blog.articles.first %}
      <article class="journal-feature">
        <a href="{{ featured_article.url }}" class="journal-feature__image">{% if featured_article.image != blank %}{{ featured_article.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: featured_article.title }}{% endif %}</a>
        <div><span class="eyebrow">FEATURED GUIDE</span><h2><a href="{{ featured_article.url }}">{{ featured_article.title }}</a></h2><p>{{ featured_article.excerpt_or_content | strip_html | truncate: 220 }}</p><a class="text-link" href="{{ featured_article.url }}">Read the guide →</a></div>
      </article>
      <div class="journal-heading"><span class="eyebrow">LATEST STORIES</span><h2>Learn, care, live better together.</h2></div>
      <div class="article-grid">
        {% for article in blog.articles offset: 1 %}
          <article class="article-card">
            <a href="{{ article.url }}" class="article-card__image">{% if article.image != blank %}{{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: article.title }}{% endif %}</a>
            <small>{% if article.tags.first %}{{ article.tags.first }} · {% endif %}{{ article.published_at | date: '%B %d, %Y' }}</small>
            <a href="{{ article.url }}"><h2>{{ article.title }}</h2></a>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 150 }}</p>
            <a class="text-link" href="{{ article.url }}">Read article →</a>
          </article>
        {% endfor %}
      </div>
      {{ paginate | default_pagination }}
    {% else %}
      <div class="journal-empty">
        <span class="eyebrow">COMING SOON</span>
        <h2>Useful guidance is being prepared.</h2>
        <p>We are building a considered library of pet-care guides. In the meantime, our team is happy to answer product questions directly.</p>
        <a class="button" href="/pages/contact">Ask KROZO</a>
      </div>
    {% endif %}
  {% endpaginate %}
</section>
{% schema %}{"name":"Editorial blog","settings":[]}{% endschema %}
