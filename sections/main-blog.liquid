<section class="journal-hero">
  <div><span class="eyebrow">{{ section.settings.hero_eyebrow }}</span><h1>{{ section.settings.hero_heading }}</h1><p>{{ section.settings.hero_text }}</p></div>
</section>
{% if section.settings.show_topics %}
  <nav class="journal-topics" aria-label="Journal topics">
    <a href="{{ blog.url }}">All guides</a>
    <a href="{{ blog.url }}/tagged/dog-care">Dog care</a>
    <a href="{{ blog.url }}/tagged/cat-care">Cat care</a>
    <a href="{{ blog.url }}/tagged/feeding">Feeding</a>
    <a href="{{ blog.url }}/tagged/enrichment">Enrichment</a>
    <a href="{{ blog.url }}/tagged/travel">Travel</a>
  </nav>
{% endif %}
<section class="section content-page journal-page">
  {% paginate blog.articles by 12 %}
    {% if blog.articles.size > 0 %}
      {% assign featured_article = blog.articles.first %}
      <article class="journal-feature">
        <a href="{{ featured_article.url }}" class="journal-feature__image">{% if featured_article.image != blank %}{{ featured_article.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: featured_article.title }}{% endif %}</a>
        <div><span class="eyebrow">FEATURED GUIDE</span><h2><a href="{{ featured_article.url }}">{{ featured_article.title }}</a></h2><p>{{ featured_article.excerpt | default: featured_article.content | strip_html | truncatewords: 25 }}</p><a class="text-link" href="{{ featured_article.url }}">Read the guide →</a></div>
      </article>
      <div class="journal-heading"><span class="eyebrow">LATEST STORIES</span><h2>Learn, care, live better together.</h2></div>
      <div class="article-grid">
        {% for article in blog.articles offset: 1 %}
          <article class="article-card">
            <a href="{{ article.url }}" class="article-card__image">
              {% if article.image != blank %}
                {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: article.title }}
              {% else %}
                <span class="article-card__placeholder" aria-hidden="true">KROZO Journal</span>
              {% endif %}
            </a>
            <small>{% if article.tags.first %}{{ article.tags.first }} · {% endif %}{{ article.published_at | date: '%B %d, %Y' }}</small>
            <a href="{{ article.url }}"><h2>{{ article.title }}</h2></a>
            <p>{{ article.excerpt | default: article.content | strip_html | truncatewords: 25 }}</p>
            <a class="text-link" href="{{ article.url }}">Read article →</a>
          </article>
        {% endfor %}
      </div>
      {{ paginate | default_pagination }}
    {% else %}
      <div class="journal-empty">
        <span class="eyebrow">COMING SOON</span>
        <h2>Useful guidance is being prepared.</h2>
        <p>We are building a considered library of pet-care guides. In the meantime, our team is happy to answer product questions directly.</p>
        <a class="button" href="/pages/contact">Ask KROZO</a>
      </div>
    {% endif %}
  {% endpaginate %}
</section>
{% if section.settings.show_signup %}
<section class="journal-signup">
  <div>
    <span class="eyebrow">{{ section.settings.signup_eyebrow }}</span>
    <h2>{{ section.settings.signup_heading }}</h2>
    <p>{{ section.settings.signup_text }}</p>
  </div>
  {% form 'customer', class: 'journal-signup__form' %}
    <input type="hidden" name="contact[tags]" value="newsletter,journal">
    {% if form.posted_successfully? %}<p class="form-success">You’re on the list — welcome to the KROZO Journal.</p>{% endif %}
    {{ form.errors | default_errors }}
    <label class="visually-hidden" for="JournalEmail">Email address</label>
    <input id="JournalEmail" type="email" name="contact[email]" autocomplete="email" placeholder="Your email address" required>
    <button type="submit">{{ section.settings.signup_button }}</button>
  {% endform %}
</section>
{% endif %}
<section class="section journal-shop">
  <div><span class="eyebrow">{{ section.settings.shop_eyebrow }}</span><h2>{{ section.settings.shop_heading }}</h2><p>{{ section.settings.shop_text }}</p></div>
  <a class="button" href="{{ routes.all_products_collection_url }}">{{ section.settings.shop_button }}</a>
</section>
{% schema %}
{"name":"Editorial blog","settings":[
  {"type":"header","content":"Journal hero"},
  {"type":"text","id":"hero_eyebrow","label":"Eyebrow","default":"THE KROZO JOURNAL"},
  {"type":"text","id":"hero_heading","label":"Heading","default":"Thoughtful guidance for life with pets."},
  {"type":"textarea","id":"hero_text","label":"Text","default":"Practical, calm and carefully considered advice for feeding, enrichment, travel and everyday care."},
  {"type":"checkbox","id":"show_topics","label":"Show topic navigation","default":false},
  {"type":"header","content":"Email signup"},
  {"type":"checkbox","id":"show_signup","label":"Show Journal email signup","default":false},
  {"type":"text","id":"signup_eyebrow","label":"Eyebrow","default":"A CALMER INBOX"},
  {"type":"text","id":"signup_heading","label":"Heading","default":"Useful pet care, without the noise."},
  {"type":"textarea","id":"signup_text","label":"Text","default":"Get practical guides, seasonal checklists and thoughtful product advice from KROZO."},
  {"type":"text","id":"signup_button","label":"Button","default":"Join the Journal →"},
  {"type":"header","content":"Shop callout"},
  {"type":"text","id":"shop_eyebrow","label":"Eyebrow","default":"PUT GOOD ADVICE INTO PRACTICE"},
  {"type":"text","id":"shop_heading","label":"Heading","default":"Essentials chosen for easier everyday care."},
  {"type":"textarea","id":"shop_text","label":"Text","default":"Explore considered products for feeding, play, travel and life at home with your pet."},
  {"type":"text","id":"shop_button","label":"Button","default":"Explore the collection"}
]}{% endschema %}
