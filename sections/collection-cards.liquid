{% unless section.settings.hide_section %}
<section id="collections" class="section section--sand krozo-six-categories" data-krozo-categories-version="2026-08-05-3" style="text-align:{{ section.settings.text_alignment }};background:{{ section.settings.background_color | default: settings.color_surface_background }};">
  <div class="section-title">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
  </div>

  <div class="collection-grid collection-grid--six">
    {% assign dogs_collection = collections['dogs'] %}
    <a class="collection-card" href="{{ dogs_collection.url | default: routes.all_products_collection_url }}">
      <img src="{{ 'krozo-hero-lifestyle.png' | asset_url }}" loading="lazy" decoding="async" alt="For Dogs collection" width="900" height="900">
      <span class="collection-card__content">
        <strong>For Dogs</strong>
        <em>Comfort, play and everyday care</em>
        <small>Explore collection →</small>
      </span>
    </a>

    {% assign cats_collection = collections['cats'] %}
    <a class="collection-card" href="{{ cats_collection.url | default: routes.all_products_collection_url }}">
      <img src="{{ 'krozo-gallery-cat.png' | asset_url }}" loading="lazy" decoding="async" alt="For Cats collection" width="900" height="900">
      <span class="collection-card__content">
        <strong>For Cats</strong>
        <em>Enrichment for curious companions</em>
        <small>Explore collection →</small>
      </span>
    </a>

    {% assign feeding_collection = collections['smart-feeding'] %}
    <a class="collection-card" href="{{ feeding_collection.url | default: routes.all_products_collection_url }}">
      <img src="{{ 'krozo-category-feeding.webp' | asset_url }}" loading="lazy" decoding="async" alt="Feeding and Hydration collection" width="900" height="900">
      <span class="collection-card__content">
        <strong>Feeding &amp; Hydration</strong>
        <em>Calmer, easier mealtimes</em>
        <small>Explore collection →</small>
      </span>
    </a>

    {% assign play_collection = collections['toys'] %}
    <a class="collection-card" href="{{ play_collection.url | default: routes.all_products_collection_url }}">
      <img src="{{ 'krozo-category-play.webp' | asset_url }}" loading="lazy" decoding="async" alt="Play and Enrichment collection" width="900" height="900">
      <span class="collection-card__content">
        <strong>Play &amp; Enrichment</strong>
        <em>Made for happier, engaged pets</em>
        <small>Explore collection →</small>
      </span>
    </a>

    {% assign travel_collection = collections['travel-essentials'] %}
    <a class="collection-card" href="{{ travel_collection.url | default: routes.all_products_collection_url }}">
      <img src="{{ 'krozo-lifestyle-banner.png' | asset_url }}" loading="lazy" decoding="async" alt="Walk and Travel collection" width="900" height="900">
      <span class="collection-card__content">
        <strong>Walk &amp; Travel</strong>
        <em>Ready for life on the go</em>
        <small>Explore collection →</small>
      </span>
    </a>

    {% assign wellness_collection = collections['pure-care'] %}
    <a class="collection-card" href="{{ wellness_collection.url | default: routes.all_products_collection_url }}">
      <img src="{{ 'krozo-category-wellness.webp' | asset_url }}" loading="lazy" decoding="async" alt="Wellness and Care collection" width="900" height="900">
      <span class="collection-card__content">
        <strong>Wellness &amp; Care</strong>
        <em>Thoughtful support for daily care</em>
        <small>Explore collection →</small>
      </span>
    </a>
  </div>

  <div id="our-standard" class="brand-standard brand-standard--embedded">
    <div class="brand-standard__media">
      <img src="{{ 'krozo-category-wellness.webp' | asset_url }}" loading="lazy" decoding="async" alt="Thoughtful everyday pet care" width="1200" height="1200">
    </div>
    <div class="brand-standard__content">
      <span class="eyebrow">THE KROZO STANDARD</span>
      <h2>Every product should earn its place in your home.</h2>
      <p class="brand-standard__lead">We choose with purpose—not simply to fill a catalogue. Each KROZO product should make a real routine calmer, easier or more enjoyable for pets and the people who love them.</p>
      <ul class="brand-standard__list">
        <li><span>01</span><div><h3>It solves a real need.</h3><p>Clear everyday value comes before novelty.</p></div></li>
        <li><span>02</span><div><h3>It respects pet and home.</h3><p>Comfort, usability and a considered look all matter.</p></div></li>
        <li><span>03</span><div><h3>It is clear before you buy.</h3><p>Useful details and responsive support help you choose confidently.</p></div></li>
      </ul>
      <a class="text-link" href="{{ routes.all_products_collection_url }}">Explore the collection →</a>
    </div>
  </div>
</section>

<style>
  .krozo-six-categories .collection-grid--six{
    display:grid!important;
    grid-template-columns:repeat(3,minmax(0,1fr))!important;
    gap:16px!important;
  }
  .krozo-six-categories .collection-grid--six>.collection-card{
    display:block!important;
    visibility:visible!important;
    opacity:1!important;
  }
  @media(max-width:750px){
    .krozo-six-categories .collection-grid--six{
      grid-template-columns:repeat(2,minmax(0,1fr))!important;
      gap:9px!important;
    }
  }
</style>
{% endunless %}

{% schema %}
{
  "name": "Shop by need",
  "settings": [
    {"type":"checkbox","id":"hide_section","label":"Hide section","default":false},
    {"type":"header","content":"Content"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"SHOP BY NEED"},
    {"type":"text","id":"heading","label":"Heading","default":"Thoughtful essentials for every part of life together."},
    {"type":"textarea","id":"text","label":"Supporting text","default":"Find purposeful products for calmer routines, happier pets, and better moments at home or away."},
    {"type":"header","content":"Style"},
    {"type":"select","id":"text_alignment","label":"Text alignment","default":"center","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}]},
    {"type":"color","id":"background_color","label":"Background color"}
  ],
  "blocks": [
    {
      "type":"collection",
      "name":"Collection",
      "settings":[
        {"type":"collection","id":"collection","label":"Collection"},
        {"type":"image_picker","id":"image","label":"Override image"},
        {"type":"text","id":"label","label":"Label override"},
        {"type":"text","id":"blurb","label":"Short benefit","default":"Considered for everyday life"}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{"name":"Shop by need","blocks":[{"type":"collection"},{"type":"collection"},{"type":"collection"}]}]
}
{% endschema %}
