<section class="section section--sand product-benefits">
  <div class="section-title">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="benefit-grid">
    {% for block in section.blocks %}
      <article {{ block.shopify_attributes }}>
        <span class="benefit-grid__icon">{{ block.settings.icon }}</span>
        <h3>{{ block.settings.heading }}</h3>
        <p>{{ block.settings.text }}</p>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{"name":"Why you'll love it","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"DESIGNED AROUND REAL LIFE"},{"type":"text","id":"heading","label":"Heading","default":"Why you'll love it."}],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"icon","label":"Icon","default":"◇"},{"type":"text","id":"heading","label":"Heading","default":"Easy to live with"},{"type":"textarea","id":"text","label":"Benefit copy","default":"A considered addition to your pet's daily routine."}]}],"presets":[{"name":"Why you'll love it","blocks":[{"type":"benefit","settings":{"icon":"♡","heading":"Made for comfort","text":"Designed to support calmer, happier everyday moments."}},{"type":"benefit","settings":{"icon":"◇","heading":"Thoughtfully chosen","text":"Useful details and a refined look that belongs in your home."}},{"type":"benefit","settings":{"icon":"↻","heading":"Simple to care for","text":"Made with real routines and easy upkeep in mind."}}]}]}
{% endschema %}
