<section id="faq" class="section store-faq">
  <div class="store-faq__intro">
    <span class="eyebrow">QUESTIONS, ANSWERED</span>
    <h2>Everything you need to feel confident.</h2>
    <p>Clear information about ordering, delivery, returns and choosing the right KROZO essential.</p>
    <a class="text-link" href="/pages/contact">Still need help? Contact us →</a>
  </div>
  <div class="store-faq__list">
    {% for block in section.blocks %}
      <details {{ block.shopify_attributes }}>
        <summary><span>{{ block.settings.question }}</span><span aria-hidden="true">+</span></summary>
        <div>{{ block.settings.answer }}</div>
      </details>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Store FAQs",
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {"type": "text", "id": "question", "label": "Question"},
        {"type": "richtext", "id": "answer", "label": "Answer"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Store FAQs",
      "blocks": [
        {"type": "question", "settings": {"question": "Where does KROZO ship?", "answer": "<p>We currently serve customers in the United States, Canada, the United Kingdom, Australia and New Zealand. Available delivery options and estimates are shown at checkout.</p>"}},
        {"type": "question", "settings": {"question": "Is shipping really complimentary?", "answer": "<p>Yes. Standard shipping is complimentary on every KROZO order. Any faster paid options, when available, are shown at checkout.</p>"}},
        {"type": "question", "settings": {"question": "How long will my order take to arrive?", "answer": "<p>Estimated delivery is 4–14 days, depending on your country and location. Your order confirmation includes the relevant delivery details.</p>"}},
        {"type": "question", "settings": {"question": "Can I return an item?", "answer": "<p>Changed your mind? You may request a return within 30 days, subject to our returns policy. If an item arrives damaged, defective or incorrect, contact us with your order number and clear photos. Depending on the issue and applicable law, we may offer a replacement, refund or a lower-impact resolution that does not require a return. This does not limit your statutory rights.</p>"}},
        {"type": "question", "settings": {"question": "How do I choose the right product or size?", "answer": "<p>Check the dimensions and guidance on the product page. If you are unsure, contact us before ordering and tell us about your pet—we will help you make a considered choice.</p>"}},
        {"type": "question", "settings": {"question": "Are KROZO products safe for pets?", "answer": "<p>Each product page includes its available material and care information. Always supervise pets during play, follow the product guidance and replace any item that becomes damaged.</p>"}},
        {"type": "question", "settings": {"question": "How can I track my order?", "answer": "<p>When tracking is available, you will receive it by email after your order is dispatched. You can also contact us with your order number for help.</p>"}},
        {"type": "question", "settings": {"question": "Which payment methods do you accept?", "answer": "<p>Available payment methods are displayed securely at checkout. Payments are encrypted and processed through Shopify-powered checkout.</p>"}},
        {"type": "question", "settings": {"question": "Can I change or cancel my order?", "answer": "<p>Contact us as quickly as possible. We will do our best to help, but changes cannot be guaranteed after an order enters processing.</p>"}},
        {"type": "question", "settings": {"question": "How do product reviews work?", "answer": "<p>Customers can submit an honest review after purchase. Reviews may be moderated for spam, privacy and relevance, but genuine critical feedback is not removed simply because it is negative.</p>"}}
      ]
    }
  ]
}
{% endschema %}
