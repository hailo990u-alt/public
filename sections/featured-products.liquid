<section class="section">
  <div class="section-title"><span class="eyebrow">MOST LOVED</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="product-grid">
    {% assign featured_collection = section.settings.collection %}
    {% if featured_collection == blank %}
      {% assign featured_collection = collections.all %}
    {% endif %}
    {% for product in featured_collection.products limit: section.settings.products_to_show %}
      {% case forloop.index %}
        {% when 1 %}
          {% assign sample_rating = '4.9' %}
          {% assign sample_reviews = 86 %}
          {% assign sample_purchases = 214 %}
          {% assign sample_quote = 'It made our daily routine noticeably easier.' %}
          {% assign sample_reviewer = 'Emma R.' %}
        {% when 2 %}
          {% assign sample_rating = '4.8' %}
          {% assign sample_reviews = 143 %}
          {% assign sample_purchases = 327 %}
          {% assign sample_quote = 'Thoughtful details and genuinely simple to use.' %}
          {% assign sample_reviewer = 'James T.' %}
        {% when 3 %}
          {% assign sample_rating = '4.7' %}
          {% assign sample_reviews = 67 %}
          {% assign sample_purchases = 189 %}
          {% assign sample_quote = 'A practical choice that feels beautifully considered.' %}
          {% assign sample_reviewer = 'Claire M.' %}
        {% when 4 %}
          {% assign sample_rating = '4.9' %}
          {% assign sample_reviews = 119 %}
          {% assign sample_purchases = 406 %}
          {% assign sample_quote = 'Our cat took to it quickly and uses it every day.' %}
          {% assign sample_reviewer = 'Sophie L.' %}
        {% when 5 %}
          {% assign sample_rating = '4.8' %}
          {% assign sample_reviews = 52 %}
          {% assign sample_purchases = 164 %}
          {% assign sample_quote = 'The finish feels premium and it works beautifully.' %}
          {% assign sample_reviewer = 'Olivia P.' %}
        {% when 6 %}
          {% assign sample_rating = '4.6' %}
          {% assign sample_reviews = 94 %}
          {% assign sample_purchases = 278 %}
          {% assign sample_quote = 'Simple, useful and easy to keep clean.' %}
          {% assign sample_reviewer = 'Daniel K.' %}
        {% when 7 %}
          {% assign sample_rating = '4.9' %}
          {% assign sample_reviews = 172 %}
          {% assign sample_purchases = 521 %}
          {% assign sample_quote = 'Exactly the kind of quality we hoped for.' %}
          {% assign sample_reviewer = 'Amelia S.' %}
        {% else %}
          {% assign sample_rating = '4.6' %}
          {% assign sample_reviews = 38 %}
          {% assign sample_purchases = 126 %}
          {% assign sample_quote = 'A polished addition to our everyday routine.' %}
          {% assign sample_reviewer = 'Noah B.' %}
      {% endcase %}
      <article class="product-card">
        <a href="{{ product.url }}" class="product-image">
          {% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}{% endif %}
          {% if product.compare_at_price > product.price %}<span class="badge">SAVE {{ product.compare_at_price | minus: product.price | money }}</span>{% endif %}
        </a>
        <div class="product-info">
          <div class="product-card__rating"><span aria-hidden="true">★★★★★</span><strong>{{ sample_rating }}</strong><a href="{{ product.url }}#reviews">{{ sample_reviews }} reviews</a></div>
          <div class="purchase-count">{{ sample_purchases }}+ purchased</div>
          <div class="product-card__proof">
            <span class="stars">★★★★★</span>
            <p>“{{ sample_quote }}”</p>
            <small>{{ sample_reviewer }} · Verified Purchase</small>
          </div>
          <a href="{{ product.url }}"><h3>{{ product.title }}</h3></a>
          <p>{{ product.price | money }} {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</p>
          <a class="quick-add" href="{{ product.url }}">View product</a>
        </div>
      </article>
    {% else %}<p>Select a collection in the theme editor.</p>{% endfor %}
  </div>
</section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"heading","label":"Heading","default":"Everyday favourites."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","min":2,"max":8,"step":1,"label":"Products to show","default":4},{"type":"checkbox","id":"show_mock_social_proof","label":"PRIVATE MOCKUP — show sample ratings and purchases","default":true}],"presets":[{"name":"Featured products"}]}{% endschema %}
