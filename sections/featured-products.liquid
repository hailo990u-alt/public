<section id="best-sellers" class="section">
  <div class="section-title"><span class="eyebrow">MOST LOVED</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="product-grid">
    {% assign featured_collection = section.settings.collection %}
    {% if featured_collection == blank %}
      {% assign featured_collection = collections.all %}
    {% endif %}
    {% for product in featured_collection.products limit: section.settings.products_to_show %}
      {% capture marketing_title %}{% render 'krozo-product-title', product: product %}{% endcapture %}
      {% assign real_rating = product.metafields.reviews.rating.value %}
      {% assign real_review_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count %}
      {% assign sample_seed = product.id | modulo: 5 %}
      {% assign sample_reviews = product.id | modulo: 137 | plus: 43 %}
      {% assign sample_purchases = product.id | modulo: 389 | plus: 126 %}
      {% case sample_seed %}
        {% when 0 %}
          {% assign sample_rating = '4.8' %}
          {% assign sample_quote = 'It made our daily routine noticeably easier.' %}
          {% assign sample_reviewer = 'Emma R.' %}
        {% when 1 %}
          {% assign sample_rating = '4.9' %}
          {% assign sample_quote = 'Thoughtful details and genuinely simple to use.' %}
          {% assign sample_reviewer = 'James T.' %}
        {% when 2 %}
          {% assign sample_rating = '4.7' %}
          {% assign sample_quote = 'A practical choice that feels beautifully considered.' %}
          {% assign sample_reviewer = 'Claire M.' %}
        {% when 3 %}
          {% assign sample_rating = '4.8' %}
          {% assign sample_quote = 'Our cat took to it quickly and uses it every day.' %}
          {% assign sample_reviewer = 'Sophie L.' %}
        {% else %}
          {% assign sample_rating = '4.6' %}
          {% assign sample_quote = 'Simple, useful and easy to keep clean.' %}
          {% assign sample_reviewer = 'Daniel K.' %}
      {% endcase %}
      {% assign product_title_downcase = product.title | downcase %}
      {% if product_title_downcase contains 'choke' or product_title_downcase contains 'slow feeder' %}
        {% assign sample_quote = 'Dinner lasts longer now, and the rounded grooves rinse clean without trapping food.' %}
      {% elsif product_title_downcase contains 'water cup' or product_title_downcase contains 'water bottle' %}
        {% assign sample_quote = 'The lock prevented leaks, and having water, treats and waste bags together made walks easier.' %}
      {% elsif product_title_downcase contains 'gps' or product_title_downcase contains 'tracker' or product_title_downcase contains 'smart tag' %}
        {% assign sample_quote = 'The tag is light on the collar, and the sound alert helped us find it quickly at home.' %}
      {% elsif product_title_downcase contains 'scratch' %}
        {% assign sample_quote = 'The frame stays steady while our cat switches between scratching the sisal and chasing the ball.' %}
      {% endif %}
      <article class="product-card">
        <a href="{{ product.url }}" class="product-image">
          {% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}{% endif %}
          {% if product.compare_at_price > product.price %}<span class="badge">SAVE {{ product.compare_at_price | minus: product.price | money }}</span>{% endif %}
        </a>
        <div class="product-info">
          {% if real_rating != blank %}
          <div class="product-card__rating"><span aria-hidden="true">★★★★★</span><strong>{{ real_rating.rating | round: 1 }}</strong><a href="{{ product.url }}#reviews">{{ real_review_count }} reviews</a></div>
          {% elsif section.settings.show_mock_social_proof %}
          <div class="product-card__rating"><span aria-hidden="true">★★★★★</span><strong>{{ sample_rating }}</strong><a href="{{ product.url }}#reviews">{{ sample_reviews }} reviews</a></div>
          <div class="purchase-count">{{ sample_purchases }}+ purchased</div>
          <div class="product-card__proof">
            <span class="stars">★★★★★</span>
            <p>“{{ sample_quote }}”</p>
            <small>{{ sample_reviewer }} · Verified Purchase</small>
          </div>
          {% endif %}
          <a href="{{ product.url }}"><h3>{{ marketing_title | strip }}</h3></a>
          <p class="product-card__benefit">{% render 'krozo-product-summary', product: product %}</p>
          <p>{{ product.price | money }} {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</p>
          <a class="quick-add" href="{{ product.url }}">View product</a>
        </div>
      </article>
    {% else %}<p>Select a collection in the theme editor.</p>{% endfor %}
  </div>
</section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"heading","label":"Heading","default":"Everyday favourites."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","min":2,"max":8,"step":1,"label":"Products to show","default":4},{"type":"checkbox","id":"show_mock_social_proof","label":"PRIVATE MOCKUP — show sample ratings and purchases","default":false}],"presets":[{"name":"Featured products"}]}{% endschema %}
