<section class="section">
  <div class="section-title"><span class="eyebrow">MOST LOVED</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="product-grid">
    {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
      <article class="product-card">
        <a href="{{ product.url }}" class="product-image">
          {% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}{% endif %}
          {% if product.compare_at_price > product.price %}<span class="badge">SAVE {{ product.compare_at_price | minus: product.price | money }}</span>{% endif %}
        </a>
        <div class="product-info">
          {% if product.metafields.reviews.rating.value != blank %}
            <div class="stars">★★★★★ <span>({{ product.metafields.reviews.rating_count }})</span></div>
          {% elsif section.settings.show_mock_social_proof or request.design_mode %}
            {% case forloop.index %}
              {% when 1 %}{% assign sample_reviews = 128 %}
              {% when 2 %}{% assign sample_reviews = 86 %}
              {% when 3 %}{% assign sample_reviews = 214 %}
              {% else %}{% assign sample_reviews = 64 %}
            {% endcase %}
            <div class="stars{% if request.design_mode %} demo-preview{% endif %}">★★★★★ <span>({{ sample_reviews }}){% if request.design_mode %} · Sample preview{% endif %}</span></div>
          {% endif %}
          {% if product.metafields.custom.purchases_count != blank %}
            <div class="purchase-count">{{ product.metafields.custom.purchases_count }}+ purchased</div>
          {% elsif section.settings.show_mock_social_proof or request.design_mode %}
            {% case forloop.index %}
              {% when 1 %}{% assign sample_purchases = 350 %}
              {% when 2 %}{% assign sample_purchases = 180 %}
              {% when 3 %}{% assign sample_purchases = 500 %}
              {% else %}{% assign sample_purchases = 120 %}
            {% endcase %}
            <div class="purchase-count{% if request.design_mode %} demo-preview{% endif %}">{{ sample_purchases }}+ purchased{% if request.design_mode %} · Sample preview{% endif %}</div>
          {% endif %}
          <a href="{{ product.url }}"><h3>{{ product.title }}</h3></a>
          <p>{{ product.price | money }} {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</p>
          <a class="quick-add" href="{{ product.url }}">View product</a>
        </div>
      </article>
    {% else %}<p>Select a collection in the theme editor.</p>{% endfor %}
  </div>
</section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"heading","label":"Heading","default":"Everyday favourites."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","min":2,"max":8,"step":1,"label":"Products to show","default":4},{"type":"checkbox","id":"show_mock_social_proof","label":"PRIVATE MOCKUP — show sample ratings and purchases","default":true}],"presets":[{"name":"Featured products"}]}{% endschema %}
